@model JwtMusicNight.WebUI.Models.AdminUsersViewModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Kullanıcı Yönetimi"; ViewData["AdminPage"] = "Users"; }
<header class="admin-heading"><div><div class="admin-kicker">Topluluk</div><h1>Kullanıcılar</h1><p>Echoa üyelerini görüntüle ve kullanıcıların erişebileceği müzik paketlerini yönet.</p></div><span class="admin-count"><i class="bi bi-people"></i> @Model.Users.Count kullanıcı</span></header>
<section class="admin-table-card"><div class="admin-table-head"><h2>Kullanıcı listesi</h2><span>Üyelik ve paket bilgileri</span></div>
    @if (Model.Users.Count == 0) { <div class="admin-empty"><i class="bi bi-people"></i>Henüz kayıtlı kullanıcı bulunmuyor.</div> }
    else { <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Ad soyad</th><th>Kullanıcı adı</th><th>E-posta</th><th>Mevcut paket</th><th>Paketi değiştir</th></tr></thead><tbody>
        @foreach (var user in Model.Users) { var initials = $"{(string.IsNullOrWhiteSpace(user.Name) ? "" : user.Name.Substring(0, 1))}{(string.IsNullOrWhiteSpace(user.Surname) ? "" : user.Surname.Substring(0, 1))}".ToUpper(); <tr><td><div class="admin-user"><span class="admin-user-avatar">@(string.IsNullOrWhiteSpace(initials) ? "?" : initials)</span><span>@user.Name @user.Surname</span></div></td><td>@@@user.UserName</td><td>@user.Email</td><td><span class="admin-pill ok"><i class="bi bi-gem"></i>@user.PackageName</span></td><td><form asp-controller="Admin" asp-action="UpdateUserPackage" method="post" class="admin-inline-form"><input type="hidden" name="id" value="@user.Id" /><select name="packageId" class="admin-select" aria-label="@user.UserName için paket">@foreach (var package in Model.Packages) { <option value="@package.PackageId" selected="@(package.PackageId == user.PackageId)">@package.PackageName</option> }</select><button type="submit" class="admin-btn admin-btn-secondary admin-btn-small"><i class="bi bi-check2"></i>Kaydet</button></form></td></tr> }
    </tbody></table></div> }
</section>
