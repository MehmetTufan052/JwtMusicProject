@model List<JwtMusicNight.WebUI.Dtos.ResultGenreDto>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Tür Yönetimi"; ViewData["AdminPage"] = "Genres"; }
<header class="admin-heading"><div><div class="admin-kicker">Katalog</div><h1>Müzik türleri</h1><p>Dinleyicilerin yeni müzikleri keşfetmesini kolaylaştıran katalog kategorilerini yönet.</p></div><span class="admin-count"><i class="bi bi-vinyl"></i> @Model.Count tür</span></header>
<section class="admin-card"><div class="admin-card-head"><h2 class="admin-card-title"><i class="bi bi-bookmark-plus"></i>Yeni tür ekle</h2></div><form asp-controller="Admin" asp-action="CreateGenre" method="post" class="admin-form-grid"><div class="field half"><label for="genreName">Tür adı</label><input id="genreName" type="text" name="genreName" class="admin-input" placeholder="Örn. Jazz, Rock, Elektronik" required /></div><div class="admin-actions"><button type="submit" class="admin-btn admin-btn-primary"><i class="bi bi-plus-lg"></i>Tür ekle</button></div></form></section>
<section class="admin-table-card"><div class="admin-table-head"><h2>Tür listesi</h2><span>Katalogda kullanılan müzik kategorileri</span></div>
    @if (Model.Count == 0) { <div class="admin-empty"><i class="bi bi-vinyl"></i>Henüz müzik türü eklenmedi.</div> }
    else { <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Tür adı</th><th>Kimlik</th><th></th></tr></thead><tbody>@foreach (var genre in Model) { <tr><td><span class="admin-pill"><i class="bi bi-music-note"></i>@genre.GenreName</span></td><td>#@genre.GenreId</td><td><div class="admin-row-actions"><form asp-controller="Admin" asp-action="DeleteGenre" method="post" onsubmit="return confirm('Bu türü silmek istediğine emin misin? Şarkıları varsa silme başarısız olur.');"><input type="hidden" name="id" value="@genre.GenreId" /><button type="submit" class="admin-btn admin-btn-danger admin-btn-small"><i class="bi bi-trash3"></i>Sil</button></form></div></td></tr> }</tbody></table></div> }
</section>
