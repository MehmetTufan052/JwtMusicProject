@using Microsoft.AspNetCore.Http
@model List<JwtMusicNight.WebUI.Dtos.ResultArtistDto>
@{
    Layout = null;
    ViewData["Title"] = "Echoa – Müziğin Yeni Sesi";
    var isLoggedIn = !string.IsNullOrWhiteSpace(Context.Session.GetString("JwtToken"));
    var artistCycles = Model.Count == 0 ? 1 : Math.Max(1, (int)Math.Ceiling(14d / Model.Count));
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Echoa ile yeni müzikler, sanatçılar ve türler keşfet." />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <style>
        :root { --bg:#000; --panel:#09090b; --panel2:#0f0f13; --panel3:#17171d; --line:rgba(255,255,255,.075); --text:#fff; --muted:#9b9aa7; --purple:#a855f7; --pink:#ec4899; --green:#53e3a6; }
        * { box-sizing:border-box; margin:0; padding:0; }
        html { scroll-behavior:smooth; }
        body { background:var(--bg); color:var(--text); font-family:'Figtree',system-ui,sans-serif; overflow-x:hidden; }
        a { color:inherit; text-decoration:none; }
        .noise { position:fixed; inset:0; z-index:10; pointer-events:none; opacity:.035; background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.75'/%3E%3C/svg%3E"); }
        .wrap { width:min(1180px,calc(100% - 48px)); margin:auto; }

        .nav { position:absolute; z-index:20; top:0; left:0; right:0; padding:22px 0; border-bottom:1px solid rgba(255,255,255,.035); }
        .nav-inner,.nav-actions,.nav-links,.brand { display:flex; align-items:center; }
        .nav-inner { justify-content:space-between; gap:24px; }
        .brand { gap:11px; font-size:1.28rem; font-weight:900; letter-spacing:-.7px; }
        .brand-mark { width:35px; height:35px; border-radius:50%; display:grid; place-items:center; background:linear-gradient(135deg,var(--purple),var(--pink)); box-shadow:0 0 32px rgba(168,85,247,.45); }
        .nav-links { gap:31px; color:var(--muted); font-size:.9rem; font-weight:650; }
        .nav-links a:hover { color:#fff; }
        .nav-actions { gap:10px; }
        .btn { height:43px; padding:0 19px; border:1px solid transparent; border-radius:50px; display:inline-flex; align-items:center; justify-content:center; gap:9px; font-size:.88rem; font-weight:800; transition:.2s; }
        .btn:hover { transform:translateY(-2px); }
        .btn-ghost { border-color:var(--line); background:rgba(255,255,255,.035); }
        .btn-ghost:hover { border-color:rgba(255,255,255,.35); background:rgba(255,255,255,.07); }
        .btn-main { background:linear-gradient(120deg,var(--purple),var(--pink)); box-shadow:0 12px 35px rgba(168,85,247,.25); }
        .btn-main:hover { filter:brightness(1.13); }

        .hero { position:relative; min-height:810px; display:flex; align-items:center; overflow:hidden; padding:132px 0 88px; }
        .hero::before,.hero::after { content:''; position:absolute; width:680px; height:680px; border-radius:50%; filter:blur(105px); }
        .hero::before { left:-390px; top:-330px; background:rgba(168,85,247,.14); }
        .hero::after { right:-360px; top:15px; background:rgba(236,72,153,.1); }
        .hero-grid { position:relative; z-index:2; display:grid; grid-template-columns:1.08fr .92fr; align-items:center; gap:70px; }
        .eyebrow { display:inline-flex; align-items:center; gap:9px; padding:7px 12px 7px 8px; border:1px solid var(--line); border-radius:50px; background:rgba(255,255,255,.035); color:#d8d7e2; font-size:.76rem; font-weight:700; }
        .eyebrow i { width:23px; height:23px; border-radius:50%; display:grid; place-items:center; background:linear-gradient(135deg,var(--purple),var(--pink)); }
        h1 { max-width:720px; margin-top:23px; font-size:clamp(3.4rem,7vw,6.6rem); line-height:.92; letter-spacing:-5px; font-weight:900; }
        .gradient-text { color:transparent; background:linear-gradient(100deg,#c084fc 5%,#f472b6 54%,#fb7185); background-clip:text; -webkit-background-clip:text; }
        .hero-copy { max-width:590px; margin-top:26px; color:var(--muted); font-size:1.07rem; line-height:1.75; }
        .hero-actions { display:flex; flex-wrap:wrap; gap:12px; margin-top:34px; }
        .hero-actions .btn { height:52px; padding:0 25px; font-size:.96rem; }
        .micro { display:flex; align-items:center; flex-wrap:wrap; gap:18px; margin-top:31px; color:#858492; font-size:.78rem; }
        .micro span { display:flex; align-items:center; gap:7px; }
        .micro i { color:var(--green); }

        .visual { position:relative; height:555px; display:grid; place-items:center; }
        .visual-glow { position:absolute; width:470px; height:410px; border-radius:50%; background:linear-gradient(145deg,rgba(124,58,237,.32),rgba(217,70,239,.12)); filter:blur(72px); animation:breathe 6s ease-in-out infinite; }
        .cover-stage { position:relative; width:540px; height:500px; display:grid; grid-template-columns:130px 250px 130px; grid-template-rows:360px 78px; align-items:center; justify-content:center; gap:18px 14px; }
        .cover { position:relative; overflow:hidden; border:1px solid rgba(255,255,255,.13); background:#111; box-shadow:0 28px 65px rgba(0,0,0,.58); }
        .cover img { width:100%; height:100%; object-fit:cover; transition:transform .6s ease; }
        .cover:hover img { transform:scale(1.05); }
        .cover-main { width:250px; height:330px; z-index:3; border-radius:26px; }
        .cover-main:hover img { transform:scale(1.05); }
        .cover-side { width:130px; height:190px; border-radius:19px; opacity:.82; filter:saturate(.8) brightness(.78); transition:transform .25s,opacity .25s,filter .25s; }
        .cover-side:hover { opacity:1; filter:none; transform:translateY(-4px); }
        .now-playing { position:relative; z-index:5; grid-column:1/4; align-self:start; width:450px; height:78px; justify-self:center; display:grid; grid-template-columns:auto 1fr auto; align-items:center; gap:13px; padding:11px 14px; border:1px solid rgba(255,255,255,.14); border-radius:18px; background:rgba(8,8,13,.94); backdrop-filter:blur(22px); box-shadow:0 24px 55px rgba(0,0,0,.58); }
        .now-thumb { width:52px; height:52px; border-radius:10px; object-fit:cover; }
        .now-copy strong,.now-copy small { display:block; }
        .now-copy strong { font-size:.79rem; }
        .now-copy small { margin-top:4px; color:var(--muted); font-size:.65rem; }
        .now-controls { display:flex; align-items:center; gap:12px; color:#8d8c99; }
        .now-play { width:38px; height:38px; border-radius:50%; display:grid; place-items:center; color:#fff; background:linear-gradient(135deg,var(--purple),var(--pink)); box-shadow:0 0 25px rgba(139,92,246,.36); }

        .ticker { position:relative; z-index:3; overflow:hidden; border-block:1px solid var(--line); background:#07070b; }
        .ticker-track { display:flex; width:max-content; animation:marquee 25s linear infinite; will-change:transform; }
        .ticker-group { flex:none; display:flex; align-items:center; gap:28px; padding:18px 28px 18px 0; color:#777684; font-size:.78rem; font-weight:800; letter-spacing:2.2px; text-transform:uppercase; white-space:nowrap; }
        .ticker a { transition:color .2s,transform .2s; }
        .ticker a:hover { color:#fff; transform:translateY(-1px); }
        .ticker i { color:var(--pink); font-size:.55rem; }

        .section { position:relative; padding:110px 0; }
        .section-head { display:flex; align-items:end; justify-content:space-between; gap:35px; margin-bottom:38px; }
        .kicker { color:#c084fc; font-size:.74rem; font-weight:850; letter-spacing:2px; text-transform:uppercase; }
        h2 { margin-top:11px; font-size:clamp(2.2rem,4.5vw,4rem); line-height:1; letter-spacing:-2.4px; }
        .section-head p { max-width:420px; color:var(--muted); line-height:1.65; }
        .feature-grid { display:grid; grid-template-columns:1.25fr .75fr .75fr; grid-template-rows:245px 245px; gap:15px; }
        .feature { position:relative; overflow:hidden; border:1px solid var(--line); border-radius:24px; background:linear-gradient(145deg,var(--panel2),var(--panel)); padding:27px; transition:.25s; box-shadow:inset 0 1px rgba(255,255,255,.025); }
        .feature:hover { transform:translateY(-5px); border-color:rgba(255,255,255,.25); }
        .feature:first-child { grid-row:1/3; }
        .feature:nth-child(4) { grid-column:2/4; }
        .feature::after { content:''; position:absolute; width:190px; height:190px; border-radius:50%; right:-75px; bottom:-85px; background:var(--card-glow); filter:blur(30px); opacity:.7; }
        .feature-icon { width:45px; height:45px; border-radius:13px; display:grid; place-items:center; background:rgba(255,255,255,.08); font-size:1.15rem; }
        .feature h3 { margin-top:26px; font-size:1.25rem; letter-spacing:-.5px; }
        .feature p { margin-top:9px; max-width:330px; color:var(--muted); line-height:1.6; font-size:.88rem; }
        .feature-main { display:flex; flex-direction:column; justify-content:end; background:linear-gradient(150deg,#160d22,#09090f 55%); }
        .feature-main h3 { font-size:2.15rem; }
        .mini-covers { position:absolute; top:32px; left:30px; right:30px; height:205px; }
        .mini-cover { position:absolute; width:155px; height:155px; overflow:hidden; border-radius:18px; border:1px solid rgba(255,255,255,.15); box-shadow:0 28px 50px rgba(0,0,0,.58); }
        .mini-cover img { width:100%; height:100%; object-fit:cover; }
        .mini-cover:nth-child(1) { left:5%; top:24px; transform:rotate(-11deg); }
        .mini-cover:nth-child(2) { left:33%; top:0; z-index:2; }
        .mini-cover:nth-child(3) { left:61%; top:27px; transform:rotate(10deg); }

        .packages { background:linear-gradient(180deg,#050508,#0b0911 50%,#050508); border-block:1px solid var(--line); }
        .package-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:13px; margin-top:40px; }
        .package { position:relative; overflow:hidden; min-height:190px; padding:24px; border:1px solid var(--line); border-radius:20px; background:rgba(255,255,255,.028); }
        .package::before { content:''; position:absolute; width:130px; height:130px; right:-50px; top:-50px; border-radius:50%; background:var(--pkg); filter:blur(35px); opacity:.5; }
        .package-level { color:var(--muted); font-size:.72rem; font-weight:800; letter-spacing:1.5px; text-transform:uppercase; }
        .package h3 { margin-top:9px; font-size:1.5rem; }
        .package p { margin-top:27px; color:var(--muted); font-size:.83rem; line-height:1.55; }
        .package i { position:absolute; right:22px; bottom:21px; font-size:1.2rem; color:var(--pkg); }

        .final { padding:125px 0; text-align:center; }
        .final-box { position:relative; overflow:hidden; padding:78px 30px; border:1px solid var(--line); border-radius:30px; background:linear-gradient(145deg,#0e0b16,#07070b); box-shadow:0 35px 90px rgba(0,0,0,.32); }
        .final-box::before,.final-box::after { content:''; position:absolute; width:330px; height:330px; border-radius:50%; filter:blur(85px); }
        .final-box::before { left:-150px; top:-190px; background:rgba(168,85,247,.48); }
        .final-box::after { right:-140px; bottom:-210px; background:rgba(236,72,153,.45); }
        .final-box>* { position:relative; z-index:2; }
        .final h2 { max-width:720px; margin:auto; }
        .final p { max-width:540px; margin:20px auto 30px; color:var(--muted); line-height:1.7; }
        footer { padding:30px 0 38px; border-top:1px solid var(--line); color:#777684; }
        .footer-inner { display:flex; align-items:center; justify-content:space-between; gap:25px; font-size:.78rem; }
        .footer-links { display:flex; gap:22px; }
        .footer-links a:hover { color:#fff; }

        @@keyframes breathe { 50% { transform:scale(1.13); opacity:.72; } }
        @@keyframes marquee { to { transform:translateX(-50%); } }
        @@media (max-width:980px) {
            .nav-links { display:none; }
            .hero { min-height:auto; padding-top:150px; }
            .hero-grid { grid-template-columns:1fr; text-align:center; }
            .hero-copy { margin-inline:auto; }
            .hero-actions,.micro { justify-content:center; }
            .visual { height:470px; }
            .feature-grid { grid-template-columns:1fr 1fr; grid-template-rows:400px 235px 235px; }
            .feature:first-child { grid-row:auto; grid-column:1/3; }
            .feature:nth-child(4) { grid-column:1/3; }
            .package-grid { grid-template-columns:1fr 1fr; }
        }
        @@media (max-width:650px) {
            .wrap { width:min(calc(100% - 30px),1180px); }
            .nav { padding:16px 0; }
            .nav-actions .btn-ghost { display:none; }
            .brand { font-size:1.1rem; }
            h1 { font-size:3.55rem; letter-spacing:-3.4px; }
            .hero { padding-top:125px; }
            .hero-grid { gap:30px; }
            .visual { height:390px; transform:scale(.82); margin:-20px -55px; }
            .cover-stage { transform:scale(.82); }
            .section { padding:80px 0; }
            .section-head { display:block; }
            .section-head p { margin-top:18px; }
            .feature-grid { grid-template-columns:1fr; grid-template-rows:390px repeat(3,220px); }
            .feature:first-child,.feature:nth-child(4) { grid-column:auto; }
            .mini-cover { width:130px; height:130px; }
            .mini-cover:nth-child(1) { left:0; }
            .mini-cover:nth-child(2) { left:29%; }
            .mini-cover:nth-child(3) { left:58%; }
            .package-grid { grid-template-columns:1fr; }
            .final-box { padding:62px 20px; }
            .footer-inner { flex-direction:column; text-align:center; }
        }
    </style>
</head>
<body>
    <div class="noise"></div>
    <header class="nav">
        <div class="wrap nav-inner">
            <a class="brand" href="/Home/Index"><span class="brand-mark"><i class="bi bi-broadcast"></i></span>Echoa</a>
            <nav class="nav-links"><a href="#discover">Keşfet</a><a href="/Artist/ArtistListV2">Sanatçılar</a><a href="/Song/Charts">Şarkılar</a><a href="#packages">Paketler</a></nav>
            <div class="nav-actions">
                @if (isLoggedIn) { <a class="btn btn-main" href="/Song/Charts">Müziklere git <i class="bi bi-arrow-right"></i></a> }
                else { <a class="btn btn-ghost" href="/Login/SignIn">Giriş yap</a><a class="btn btn-main" href="/Register/SignUp">Ücretsiz başla</a> }
            </div>
        </div>
    </header>

    <main>
        <section class="hero">
            <div class="wrap hero-grid">
                <div>
                    <div class="eyebrow"><i class="bi bi-stars"></i> Müziğin yeni nesil deneyimi</div>
                    <h1>Sesini bul.<br /><span class="gradient-text">Ritmini yaşa.</span></h1>
                    <p class="hero-copy">Her ruh hâline bir şarkı, her ana yeni bir ses. Sanatçıları keşfet, türler arasında dolaş ve müziğini kesintisiz dinle.</p>
                    <div class="hero-actions"><a class="btn btn-main" href="/Song/Charts"><i class="bi bi-play-fill"></i> Müziği keşfet</a><a class="btn btn-ghost" href="/Artist/ArtistListV2"><i class="bi bi-people"></i> Sanatçılara göz at</a></div>
                    <div class="micro"><span><i class="bi bi-check-circle-fill"></i> Anında dinle</span><span><i class="bi bi-check-circle-fill"></i> Sana özel paketler</span><span><i class="bi bi-check-circle-fill"></i> Her cihazda</span></div>
                </div>
                <div class="visual" aria-hidden="true">
                    <div class="visual-glow"></div>
                    <div class="cover-stage">
                        <div class="cover cover-side"><img src="/images/starboy.jpg" alt="" /></div>
                        <div class="cover cover-main"><img src="/images/Lose_Yourself.jpg" alt="" /></div>
                        <div class="cover cover-side"><img src="/images/believer.jpg" alt="" /></div>
                        <div class="now-playing"><img class="now-thumb" src="/images/Lose_Yourself.jpg" alt="" /><div class="now-copy"><strong>Lose Yourself</strong><small>Eminem · Echoa Mix</small></div><div class="now-controls"><i class="bi bi-skip-backward-fill"></i><span class="now-play"><i class="bi bi-play-fill"></i></span><i class="bi bi-skip-forward-fill"></i></div></div>
                    </div>
                </div>
            </div>
        </section>

        <div class="ticker"><div class="ticker-track">
            @if (Model.Count > 0)
            {
                @for (var group = 0; group < 2; group++)
                {
                    <div class="ticker-group" aria-hidden="@(group == 1 ? "true" : "false")">
                        @for (var cycle = 0; cycle < artistCycles; cycle++)
                        {
                            @foreach (var artist in Model)
                            {
                                <a href="/Artist/ArtistDetail/@artist.ArtistId">@artist.ArtistName</a><i class="bi bi-circle-fill"></i>
                            }
                        }
                    </div>
                }
            }
            else
            {
                @for (var group = 0; group < 2; group++)
                {
                    <div class="ticker-group" aria-hidden="@(group == 1 ? "true" : "false")">
                        @for (var cycle = 0; cycle < 5; cycle++)
                        {
                            <span>Sanatçılarını keşfet</span><i class="bi bi-circle-fill"></i><span>Yeni seslere kulak ver</span><i class="bi bi-circle-fill"></i><span>Ritmini Echoa'da bul</span><i class="bi bi-circle-fill"></i>
                        }
                    </div>
                }
            }
        </div>

        <section class="section" id="discover"><div class="wrap">
            <div class="section-head"><div><div class="kicker">Echoa dünyası</div><h2>Dinlemekten fazlası.</h2></div><p>Sevdiğin şarkılara ulaşmanın en hızlı, sade ve renkli yolu. Aradığın müzik deneyimi tek yerde.</p></div>
            <div class="feature-grid">
                <a class="feature feature-main" href="/Song/Charts" style="--card-glow:rgba(168,85,247,.7)"><div class="mini-covers"><div class="mini-cover"><img src="/images/highhopes.jpg" alt="" /></div><div class="mini-cover"><img src="/images/experience.jpg" alt="" /></div><div class="mini-cover"><img src="/images/goosebumps.jpg" alt="" /></div></div><h3>Yeni favorin<br />bir dokunuş uzakta.</h3><p>En çok dinlenen parçaları ve yeni sesleri keşfet.</p></a>
                <a class="feature" href="/Artist/ArtistListV2" style="--card-glow:rgba(236,72,153,.65)"><div class="feature-icon"><i class="bi bi-mic"></i></div><h3>Sanatçıları keşfet</h3><p>Sevdiğin seslerin bütün şarkılarına tek yerden ulaş.</p></a>
                <a class="feature" href="/Song/Charts" style="--card-glow:rgba(83,227,166,.55)"><div class="feature-icon"><i class="bi bi-bar-chart-line"></i></div><h3>Top listeler</h3><p>Şu anda herkesin dinlediği parçaları yakala.</p></a>
                <a class="feature" href="/Song/Charts" style="--card-glow:rgba(59,130,246,.6)"><div class="feature-icon"><i class="bi bi-grid"></i></div><h3>Her moda uygun türler</h3><p>Pop'tan rock'a, cazdan elektroniğe uzanan geniş müzik dünyasında kaybol.</p></a>
            </div>
        </div></section>

        <section class="section packages" id="packages"><div class="wrap">
            <div class="section-head"><div><div class="kicker">Özgürce seç</div><h2>Ritmin kadar esnek.</h2></div><p>Dört farklı seviye, tek bir amaç: sana uygun müziği doğru paketle buluşturmak.</p></div>
            <div class="package-grid">
                <div class="package" style="--pkg:#d1d5db"><div class="package-level">Seviye 01</div><h3>Basic</h3><p>Müzik dünyasına ilk adımını at ve temel koleksiyonu keşfet.</p><i class="bi bi-disc"></i></div>
                <div class="package" style="--pkg:#fbbf24"><div class="package-level">Seviye 02</div><h3>Gold</h3><p>Daha geniş bir kataloğun kapılarını aç ve daha fazlasını dinle.</p><i class="bi bi-star-fill"></i></div>
                <div class="package" style="--pkg:#c084fc"><div class="package-level">Seviye 03</div><h3>Premium</h3><p>Popüler parçalar ve seçkin içeriklerle ritmini hiç kaybetme.</p><i class="bi bi-gem"></i></div>
                <div class="package" style="--pkg:#f472b6"><div class="package-level">Seviye 04</div><h3>Elit</h3><p>Echoa kataloğunun tamamını özgürce keşfet ve dinle.</p><i class="bi bi-stars"></i></div>
            </div>
        </div></section>

        <section class="final"><div class="wrap final-box"><h2>Bir sonraki favori şarkın seni bekliyor.</h2><p>Echoa'ya katıl, müzik dünyanı genişlet ve sana eşlik edecek yeni sesleri bugün keşfet.</p><a class="btn btn-main" href="@(isLoggedIn ? "/Song/Charts" : "/Register/SignUp")">@(isLoggedIn ? "Dinlemeye devam et" : "Ücretsiz hesap oluştur") <i class="bi bi-arrow-up-right"></i></a></div></section>
    </main>

    <footer><div class="wrap footer-inner"><a class="brand" href="/Home/Index"><span class="brand-mark"><i class="bi bi-broadcast"></i></span>Echoa</a><span>© @DateTime.Now.Year Echoa. Müziğin yeni sesi.</span><div class="footer-links"><a href="/Artist/ArtistListV2">Sanatçılar</a><a href="/Song/Charts">Şarkılar</a><a href="/Login/SignIn">Giriş</a></div></div></footer>
</body>
</html>
