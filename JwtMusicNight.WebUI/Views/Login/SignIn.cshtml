@model JwtMusicNight.WebUI.Dtos.LoginDto
@{
    Layout = null;
    ViewData["Title"] = "Giriş yap – Echoa";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <style>
        :root {
            --bg: #07070c;
            --panel: #0f0f16;
            --panel-2: #16161f;
            --line: rgba(255,255,255,.09);
            --txt: #ffffff;
            --txt-2: #a8a8bb;
            --txt-3: #62627a;
            --accent: #a855f7;
            --accent-2: #ec4899;
            --ok: #1ed760;
            --danger: #f43f5e;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        body {
            background: var(--bg);
            color: var(--txt);
            font-family: 'Figtree', system-ui, sans-serif;
            overflow-x: hidden;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .auth {
            display: grid;
            grid-template-columns: 1.05fr .95fr;
            min-height: 100vh;
        }

        /* ---------- LEFT STAGE ---------- */
        .stage {
            position: relative;
            overflow: hidden;
            padding: 44px 52px;
            display: flex;
            flex-direction: column;
            background: var(--panel);
        }

        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            pointer-events: none;
        }

        .orb-a {
            width: 420px;
            height: 420px;
            top: -160px;
            left: -120px;
            background: rgba(168,85,247,.5);
            animation: floatOrb 19s ease-in-out infinite;
        }

        .orb-b {
            width: 340px;
            height: 340px;
            bottom: -130px;
            right: -90px;
            background: rgba(236,72,153,.38);
            animation: floatOrb 24s ease-in-out infinite reverse;
        }

        .stage > *:not(.orb) {
            position: relative;
            z-index: 1;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 11px;
            font-weight: 900;
            font-size: 1.32rem;
            letter-spacing: -.6px;
        }

        .brand-dot {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            display: grid;
            place-items: center;
            font-size: 1rem;
        }

        .stage-mid {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 40px 0;
        }

        .stage-title {
            font-size: clamp(2.2rem, 4.2vw, 3.5rem);
            font-weight: 900;
            letter-spacing: -2.2px;
            line-height: 1.04;
            max-width: 15ch;
            animation: fadeUp .8s cubic-bezier(.22,1,.36,1) both;
        }

            .stage-title em {
                font-style: normal;
                background: linear-gradient(120deg, var(--accent), var(--accent-2));
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
            }

        .stage-sub {
            margin-top: 18px;
            font-size: 1.02rem;
            color: var(--txt-2);
            max-width: 38ch;
            line-height: 1.6;
            animation: fadeUp .8s .1s cubic-bezier(.22,1,.36,1) both;
        }

        .tiles {
            display: flex;
            gap: 12px;
            margin-top: 40px;
            animation: fadeUp .8s .18s cubic-bezier(.22,1,.36,1) both;
        }

        .tile {
            width: 78px;
            height: 78px;
            border-radius: 14px;
            display: grid;
            place-items: center;
            font-size: 1.7rem;
            color: rgba(255,255,255,.9);
            animation: bob 5.5s ease-in-out infinite;
        }

            .tile:nth-child(1) {
                background: linear-gradient(140deg,#7c3aed,#a855f7);
                animation-delay: 0s;
            }

            .tile:nth-child(2) {
                background: linear-gradient(140deg,#ec4899,#f43f5e);
                animation-delay: .5s;
            }

            .tile:nth-child(3) {
                background: linear-gradient(140deg,#0ea5e9,#22d3ee);
                animation-delay: 1s;
            }

            .tile:nth-child(4) {
                background: linear-gradient(140deg,#10b981,#1ed760);
                animation-delay: 1.5s;
            }

        .np-card {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-top: 40px;
            padding: 14px 16px;
            width: fit-content;
            border-radius: 14px;
            background: rgba(255,255,255,.05);
            border: 1px solid var(--line);
            backdrop-filter: blur(20px);
            animation: fadeUp .8s .26s cubic-bezier(.22,1,.36,1) both;
        }

        .np-art {
            width: 44px;
            height: 44px;
            border-radius: 9px;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            display: grid;
            place-items: center;
            font-size: 1.15rem;
        }

        .np-t {
            font-size: .9rem;
            font-weight: 700;
        }

        .np-s {
            font-size: .76rem;
            color: var(--txt-3);
        }

        .eq {
            display: flex;
            align-items: flex-end;
            gap: 3px;
            width: 22px;
            height: 18px;
        }

            .eq span {
                flex: 1;
                background: var(--ok);
                border-radius: 1px;
                animation: eqBar .9s ease-in-out infinite;
            }

                .eq span:nth-child(2) {
                    animation-delay: .2s;
                }

                .eq span:nth-child(3) {
                    animation-delay: .4s;
                }

                .eq span:nth-child(4) {
                    animation-delay: .6s;
                }

        .stage-foot {
            display: flex;
            gap: 20px;
            font-size: .82rem;
            color: var(--txt-3);
        }

        /* ---------- RIGHT PANEL ---------- */
        .panel {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 44px 40px;
            background: var(--bg);
        }

        .card {
            width: 100%;
            max-width: 394px;
            animation: fadeUp .7s .08s cubic-bezier(.22,1,.36,1) both;
        }

        .card-kicker {
            font-size: .74rem;
            font-weight: 800;
            letter-spacing: 1.7px;
            text-transform: uppercase;
            color: var(--accent);
            margin-bottom: 10px;
        }

        .card-title {
            font-size: 2.05rem;
            font-weight: 800;
            letter-spacing: -1.2px;
        }

        .card-sub {
            margin-top: 8px;
            font-size: .94rem;
            color: var(--txt-2);
        }

        .alert {
            display: flex;
            align-items: flex-start;
            gap: 11px;
            margin-top: 22px;
            padding: 13px 15px;
            border-radius: 12px;
            background: rgba(244,63,94,.1);
            border: 1px solid rgba(244,63,94,.32);
            color: #ffd9e1;
            font-size: .88rem;
            line-height: 1.45;
            animation: shake .45s ease;
        }

            .alert i {
                color: var(--danger);
                font-size: 1.1rem;
                flex-shrink: 0;
            }

        form {
            margin-top: 26px;
        }

        .field {
            margin-bottom: 16px;
        }

            .field label {
                display: block;
                font-size: .8rem;
                font-weight: 700;
                color: var(--txt-2);
                margin-bottom: 7px;
            }

        .wrap {
            position: relative;
        }

            .wrap > i.lead {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--txt-3);
                font-size: 1.05rem;
                transition: color .22s;
            }

        .inp {
            width: 100%;
            height: 50px;
            border-radius: 13px;
            border: 1px solid var(--line);
            background: var(--panel-2);
            color: var(--txt);
            padding: 0 46px;
            font-family: inherit;
            font-size: .95rem;
            outline: none;
            transition: border-color .22s, box-shadow .22s, background .22s;
        }

            .inp::placeholder {
                color: var(--txt-3);
            }

            .inp:focus {
                border-color: rgba(168,85,247,.75);
                box-shadow: 0 0 0 4px rgba(168,85,247,.14);
                background: #191922;
            }

        .wrap:focus-within > i.lead {
            color: var(--accent);
        }

        .peek {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            width: 34px;
            height: 34px;
            border: none;
            border-radius: 9px;
            background: transparent;
            color: var(--txt-3);
            cursor: pointer;
            font-size: 1.05rem;
        }

            .peek:hover {
                color: var(--txt);
                background: rgba(255,255,255,.06);
            }

        .row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin: 4px 0 22px;
            font-size: .85rem;
        }

        .check {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--txt-2);
            cursor: pointer;
        }

            .check input {
                width: 16px;
                height: 16px;
                accent-color: var(--accent);
                cursor: pointer;
            }

        .row a {
            color: var(--txt-2);
        }

            .row a:hover {
                color: var(--txt);
            }

        .btn {
            width: 100%;
            height: 52px;
            border: none;
            border-radius: 13px;
            background: linear-gradient(120deg, var(--accent), var(--accent-2));
            color: #fff;
            font-family: inherit;
            font-size: 1rem;
            font-weight: 800;
            letter-spacing: -.2px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            position: relative;
            overflow: hidden;
            transition: transform .22s cubic-bezier(.34,1.56,.64,1), filter .22s;
        }

            .btn:hover {
                transform: translateY(-2px);
                filter: brightness(1.12);
            }

            .btn:active {
                transform: translateY(0) scale(.985);
            }

            .btn i {
                transition: transform .25s;
            }

            .btn:hover i {
                transform: translateX(4px);
            }

        .sep {
            display: flex;
            align-items: center;
            gap: 14px;
            margin: 24px 0;
            color: var(--txt-3);
            font-size: .78rem;
        }

            .sep::before, .sep::after {
                content: '';
                flex: 1;
                height: 1px;
                background: var(--line);
            }

        .foot {
            text-align: center;
            font-size: .92rem;
            color: var(--txt-2);
        }

            .foot a {
                color: var(--accent);
                font-weight: 700;
            }

                .foot a:hover {
                    text-decoration: underline;
                }

        .demo {
            margin-top: 26px;
            padding: 15px;
            border-radius: 13px;
            border: 1px dashed var(--line);
            background: rgba(255,255,255,.02);
        }

        .demo-h {
            font-size: .76rem;
            font-weight: 800;
            letter-spacing: .5px;
            text-transform: uppercase;
            color: var(--txt-3);
            margin-bottom: 11px;
        }

        .demo-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
        }

        .dchip {
            border: 1px solid var(--line);
            background: var(--panel-2);
            color: var(--txt-2);
            border-radius: 50px;
            height: 29px;
            padding: 0 13px;
            font-family: inherit;
            font-size: .79rem;
            font-weight: 700;
            cursor: pointer;
            transition: all .18s;
        }

            .dchip:hover {
                color: var(--txt);
                border-color: rgba(168,85,247,.6);
            }

            .dchip:active {
                transform: scale(.94);
            }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(24px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes floatOrb {
            0%, 100% {
                transform: translate(0,0) scale(1);
            }

            50% {
                transform: translate(44px,-30px) scale(1.16);
            }
        }

        @@keyframes bob {
            0%, 100% {
                transform: translateY(0) rotate(0deg);
            }

            50% {
                transform: translateY(-11px) rotate(-3deg);
            }
        }

        @@keyframes eqBar {
            0%, 100% {
                height: 22%;
            }

            50% {
                height: 100%;
            }
        }

        @@keyframes shake {
            0%, 100% {
                transform: translateX(0);
            }

            20% {
                transform: translateX(-7px);
            }

            40% {
                transform: translateX(6px);
            }

            60% {
                transform: translateX(-4px);
            }

            80% {
                transform: translateX(2px);
            }
        }

        @@media (max-width: 940px) {
            .auth {
                grid-template-columns: 1fr;
            }

            .stage {
                display: none;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .01ms !important;
            }
        }
    </style>
</head>
<body>
    <div class="auth">

        <section class="stage">
            <div class="orb orb-a"></div>
            <div class="orb orb-b"></div>

            <div class="brand">
                <div class="brand-dot"><i class="bi bi-broadcast"></i></div>
                Echoa
            </div>

            <div class="stage-mid">
                <h1 class="stage-title">Sesin <em>yankısı</em> burada başlıyor.</h1>
                <p class="stage-sub">
                    Yirmi binin üzerinde parça, paketine göre açılan kütüphane
                    ve hiç durmayan bir çalma listesi.
                </p>

                <div class="tiles">
                    <div class="tile"><i class="bi bi-music-note-beamed"></i></div>
                    <div class="tile"><i class="bi bi-vinyl"></i></div>
                    <div class="tile"><i class="bi bi-boombox"></i></div>
                    <div class="tile"><i class="bi bi-headphones"></i></div>
                </div>

                <div class="np-card">
                    <div class="np-art"><i class="bi bi-play-fill"></i></div>
                    <div>
                        <div class="np-t">Nuvole Bianche</div>
                        <div class="np-s">Ludovico Einaudi</div>
                    </div>
                    <span class="eq"><span></span><span></span><span></span><span></span></span>
                </div>
            </div>

            <div class="stage-foot">
                <span>Basic</span>
                <span>Gold</span>
                <span>Premium</span>
                <span>Elit</span>
            </div>
        </section>

        <section class="panel">
            <div class="card">
                <div class="card-kicker">Tekrar hoş geldin</div>
                <h2 class="card-title">Giriş yap</h2>
                <p class="card-sub">Dinlemeye kaldığın yerden devam et.</p>

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert" role="alert">
                        <i class="bi bi-exclamation-octagon-fill"></i>
                        <span>@ViewBag.ErrorMessage</span>
                    </div>
                }

                <form method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="field">
                        <label for="Username">Kullanıcı adı</label>
                        <div class="wrap">
                            <i class="bi bi-at lead"></i>
                            <input asp-for="Username" id="Username" name="Username" class="inp"
                                   type="text" placeholder="basickullanici" autocomplete="username" />
                        </div>
                    </div>

                    <div class="field">
                        <label for="Password">Şifre</label>
                        <div class="wrap">
                            <i class="bi bi-lock lead"></i>
                            <input asp-for="Password" id="Password" name="Password" class="inp"
                                   type="password" placeholder="••••••••" autocomplete="current-password" />
                            <button class="peek" type="button" id="peek" aria-label="Şifreyi göster">
                                <i class="bi bi-eye" id="peekIcon"></i>
                            </button>
                        </div>
                    </div>

                    <div class="row">
                        <label class="check">
                            <input type="checkbox" name="remember" />
                            Beni hatırla
                        </label>
                        <a href="#">Şifremi unuttum</a>
                    </div>

                    <button class="btn" type="submit">
                        Giriş yap
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </form>

                <div class="sep">veya</div>

                <div class="foot">
                    Hesabın yok mu?
                    <a asp-controller="Register" asp-action="SignUp">Ücretsiz oluştur</a>
                </div>

                <div class="demo">
                    <div class="demo-h">Test hesapları</div>
                    <div class="demo-chips">
                        <button class="dchip" type="button" data-u="basickullanici">Basic</button>
                        <button class="dchip" type="button" data-u="goldkullanici">Gold</button>
                        <button class="dchip" type="button" data-u="premiumkullanici">Premium</button>
                        <button class="dchip" type="button" data-u="elitkullanici">Elit</button>
                    </div>
                </div>
            </div>
        </section>

    </div>

    <script>
        var pw = document.getElementById('Password');
        var peek = document.getElementById('peek');
        var peekIcon = document.getElementById('peekIcon');

        peek.addEventListener('click', function () {
            var show = pw.type === 'password';
            pw.type = show ? 'text' : 'password';
            peekIcon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
            peek.setAttribute('aria-label', show ? 'Şifreyi gizle' : 'Şifreyi göster');
        });

        document.querySelectorAll('.dchip').forEach(function (b) {
            b.addEventListener('click', function () {
                document.getElementById('Username').value = b.dataset.u;
                pw.value = 'Sifre123!';
                document.getElementById('Username').focus();
            });
        });
    </script>
</body>
</html>