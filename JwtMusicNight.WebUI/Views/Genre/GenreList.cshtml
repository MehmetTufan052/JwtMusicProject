@model JwtMusicNight.WebUI.Models.GenrePageViewModel
@{
    Layout = null;
    ViewData["Title"] = "Türler – Echoa";
    var songs = Model.Songs.OrderByDescending(x => x.ListenCount).ToList();
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <script src="/js/spa-router.js"></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <style>
        :root { --bg:#000; --panel:#121212; --panel2:#181818; --panel3:#232323; --line:rgba(255,255,255,.09); --txt:#fff; --muted:#aaa9b7; --muted2:#696978; --accent:#a855f7; --pink:#ec4899; --player:76px; --rail:232px; }
        * { box-sizing:border-box; margin:0; padding:0; }
        html,body { height:100%; }
        body { background:var(--bg); color:var(--txt); font-family:'Figtree',system-ui,sans-serif; overflow:hidden; }
        a { color:inherit; text-decoration:none; }
        button,input { font:inherit; }
        .shell { width:100%; max-width:100vw; height:100dvh; padding:8px; display:grid; grid-template-columns:var(--rail) minmax(0,1fr); grid-template-rows:minmax(0,1fr) var(--player); gap:8px; overflow:hidden; }
        .sidebar { min-height:0; display:flex; flex-direction:column; gap:8px; }
        .side-box { padding:16px 12px; border-radius:10px; background:var(--panel); }
        .brand { padding:4px 8px 14px; display:flex; align-items:center; gap:10px; font-weight:900; font-size:1.18rem; }
        .brand-mark { width:27px; height:27px; border-radius:50%; display:grid; place-items:center; background:linear-gradient(135deg,var(--accent),var(--pink)); box-shadow:0 0 25px rgba(168,85,247,.35); }
        .nav-item { position:relative; padding:10px; border-radius:7px; display:flex; align-items:center; gap:14px; color:var(--muted); font-size:.91rem; font-weight:650; }
        .nav-item i { font-size:1.16rem; }
        .nav-item:hover,.nav-item.active { color:#fff; background:var(--panel3); }
        .nav-item.active::before { content:''; position:absolute; left:0; width:3px; height:60%; border-radius:3px; background:linear-gradient(var(--accent),var(--pink)); }
        .side-feature { flex:1; min-height:0; padding:20px; border-radius:10px; display:flex; flex-direction:column; justify-content:flex-end; overflow:hidden; position:relative; background:linear-gradient(150deg,#24112d,#15121b 60%); }
        .side-feature::before { content:''; position:absolute; width:190px; height:190px; border-radius:50%; top:-75px; right:-75px; background:rgba(236,72,153,.35); filter:blur(35px); }
        .side-icon { width:55px; height:55px; border-radius:16px; display:grid; place-items:center; background:linear-gradient(135deg,var(--accent),var(--pink)); font-size:1.35rem; margin-bottom:18px; }
        .side-feature h3 { font-size:1.15rem; }
        .side-feature p { margin-top:8px; color:var(--muted); line-height:1.55; font-size:.79rem; }

        .main { min-width:0; min-height:0; overflow-x:hidden; overflow-y:auto; border-radius:10px; background:var(--panel); }
        .topbar { position:sticky; top:0; z-index:20; padding:14px 24px; display:flex; align-items:center; gap:14px; background:rgba(18,18,18,.84); backdrop-filter:blur(18px); border-bottom:1px solid transparent; }
        .topbar.stuck { border-bottom-color:var(--line); }
        .search { position:relative; flex:1; max-width:390px; min-width:0; }
        .search i { position:absolute; left:13px; top:50%; transform:translateY(-50%); color:var(--muted2); }
        .search input { width:100%; height:39px; padding:0 16px 0 39px; border:1px solid var(--line); border-radius:50px; outline:0; background:var(--panel2); color:#fff; }
        .search input:focus { border-color:rgba(255,255,255,.3); }
        .spacer { flex:1; }
        .pkg { padding:8px 14px; border-radius:50px; background:linear-gradient(135deg,var(--accent),var(--pink)); font-size:.78rem; font-weight:800; }
        .avatar { width:32px; height:32px; border-radius:50%; display:grid; place-items:center; background:var(--panel3); color:var(--muted); cursor:pointer; }
        .user-menu { position:relative; }
        .user-dropdown { position:absolute; top:calc(100% + 10px); right:0; min-width:180px; background:var(--panel2); border:1px solid var(--line); border-radius:12px; padding:8px; display:none; flex-direction:column; gap:4px; z-index:50; box-shadow:0 16px 40px rgba(0,0,0,.4); }
        .user-dropdown.show { display:flex; }
        .user-dropdown-pkg { display:flex; align-items:center; gap:7px; padding:8px 10px; font-size:.78rem; color:var(--muted); border-bottom:1px solid var(--line); margin-bottom:4px; }
        .user-dropdown-logout { display:flex; align-items:center; gap:8px; padding:8px 10px; border-radius:8px; font-size:.82rem; color:var(--txt); cursor:pointer; }
        .user-dropdown-logout:hover { background:var(--panel3); color:#f43f5e; }
        .user-dropdown-admin { display:flex; align-items:center; gap:8px; padding:8px 10px; border-radius:8px; font-size:.82rem; color:var(--txt); cursor:pointer; }
        .user-dropdown-admin:hover { background:var(--panel3); color:var(--accent); }

        .hero { position:relative; overflow:hidden; padding:58px 24px 46px; background:linear-gradient(125deg,#261035 0,#17121d 45%,#121212 78%); }
        .hero::after { content:''; position:absolute; width:360px; height:360px; right:-80px; top:-170px; border-radius:50%; background:rgba(236,72,153,.25); filter:blur(70px); }
        .hero>* { position:relative; z-index:2; }
        .eyebrow { color:#d7b7f5; font-size:.73rem; font-weight:850; letter-spacing:1.8px; text-transform:uppercase; }
        h1 { margin-top:10px; font-size:clamp(3rem,6vw,5.1rem); line-height:.95; letter-spacing:-3.5px; }
        .hero p { max-width:570px; margin-top:17px; color:var(--muted); line-height:1.65; }
        .hero-meta { display:flex; gap:10px; margin-top:23px; }
        .hero-meta span { padding:7px 12px; border:1px solid var(--line); border-radius:50px; background:rgba(255,255,255,.04); font-size:.75rem; color:#d1d0da; }

        .content { width:100%; min-width:0; padding:33px 24px 42px; }
        .section-head { display:flex; justify-content:space-between; align-items:end; gap:20px; margin:32px 0 18px; }
        h2 { font-size:1.5rem; letter-spacing:-.7px; }
        .count { color:var(--muted2); font-size:.78rem; }
        .genre-picker { position:relative; overflow:hidden; padding:26px; border:1px solid rgba(192,132,252,.22); border-radius:22px; background:linear-gradient(130deg,rgba(168,85,247,.13),rgba(236,72,153,.06) 48%,rgba(255,255,255,.025)); box-shadow:0 24px 60px rgba(0,0,0,.2); }
        .genre-picker::before { content:''; position:absolute; width:220px; height:220px; top:-135px; right:-65px; border-radius:50%; background:rgba(236,72,153,.3); filter:blur(58px); pointer-events:none; }
        .picker-head { position:relative; z-index:2; display:flex; align-items:center; gap:15px; margin-bottom:21px; }
        .picker-icon { width:48px; height:48px; flex:none; border-radius:15px; display:grid; place-items:center; color:#fff; background:linear-gradient(135deg,var(--accent),var(--pink)); box-shadow:0 12px 28px rgba(168,85,247,.28); font-size:1.15rem; }
        .picker-kicker { color:#d8b4fe; font-size:.67rem; font-weight:850; letter-spacing:1.7px; text-transform:uppercase; }
        .picker-title { margin-top:3px; font-size:1.34rem; font-weight:850; letter-spacing:-.5px; }
        .picker-hint { margin-left:auto; color:var(--muted2); font-size:.75rem; }
        .chips { position:relative; z-index:2; display:grid; grid-template-columns:repeat(auto-fit,minmax(125px,1fr)); gap:10px; }
        .chip { min-height:48px; padding:0 15px; border:1px solid var(--line); border-radius:13px; cursor:pointer; color:#dad9e2; background:rgba(255,255,255,.045); display:flex; align-items:center; justify-content:center; gap:8px; font-size:.82rem; font-weight:750; transition:.22s; }
        .chip i { color:#c084fc; font-size:.92rem; transition:.2s; }
        .chip:hover { color:#fff; border-color:rgba(192,132,252,.38); background:rgba(168,85,247,.12); transform:translateY(-3px); }
        .chip.active { color:#fff; border-color:transparent; background:linear-gradient(125deg,var(--accent),var(--pink)); box-shadow:0 10px 28px rgba(168,85,247,.27); transform:translateY(-2px); }
        .chip.active i { color:#fff; }

        .grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(155px,1fr)); gap:23px 16px; }
        .song { min-width:0; cursor:pointer; animation:rise .5s cubic-bezier(.22,1,.36,1) both; }
        .song.hidden { display:none; }
        .cover { position:relative; aspect-ratio:1; overflow:hidden; border-radius:13px; background:linear-gradient(135deg,var(--accent),var(--pink)); box-shadow:0 15px 35px rgba(0,0,0,.25); transition:transform .24s; }
        .song:hover .cover { transform:translateY(-6px); }
        .cover img { width:100%; height:100%; object-fit:cover; display:block; }
        .fallback { height:100%; display:grid; place-items:center; font-size:2.6rem; font-weight:900; }
        .cover::after { content:''; position:absolute; inset:0; background:linear-gradient(to top,rgba(0,0,0,.48),transparent 55%); opacity:0; transition:.2s; }
        .song:hover .cover::after { opacity:1; }
        .play { position:absolute; z-index:3; right:10px; bottom:10px; width:45px; height:45px; border:0; border-radius:50%; display:grid; place-items:center; cursor:pointer; color:#fff; background:linear-gradient(135deg,var(--accent),var(--pink)); box-shadow:0 10px 25px rgba(168,85,247,.4); opacity:0; transform:translateY(8px); transition:.22s; }
        .song:hover .play,.play:focus-visible { opacity:1; transform:none; }
        .lock { position:absolute; z-index:3; top:10px; right:10px; width:31px; height:31px; border-radius:50%; display:grid; place-items:center; background:rgba(0,0,0,.72); color:#fbbf24; }
        .song-title { margin-top:12px; font-size:.93rem; font-weight:750; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .song-sub { margin-top:4px; color:var(--muted2); font-size:.76rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .song-meta { margin-top:9px; display:flex; align-items:center; justify-content:space-between; gap:7px; }
        .genre { color:var(--muted); font-size:.7rem; }
        .badge { padding:4px 8px; border-radius:50px; background:rgba(168,85,247,.16); color:#c084fc; font-size:.66rem; font-weight:800; }
        .empty { display:none; padding:60px 20px; text-align:center; color:var(--muted2); }
        .empty i { display:block; margin-bottom:12px; font-size:2.2rem; }

        .player { grid-column:1/-1; min-width:0; overflow:hidden; display:flex; align-items:center; gap:16px; padding:0 16px; }
        .now { width:255px; min-width:0; display:flex; align-items:center; gap:12px; }
        .now-art { width:52px; height:52px; flex:none; border-radius:8px; display:grid; place-items:center; background:linear-gradient(135deg,var(--accent),var(--pink)); }
        .now-name { font-size:.86rem; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .now-artist { margin-top:3px; color:var(--muted2); font-size:.72rem; }
        .controls { flex:1; min-width:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px; }
        .controls-row { display:flex; align-items:center; justify-content:center; gap:18px; }
        .controls button { border:0; background:transparent; color:var(--muted); cursor:pointer; font-size:1rem; }
        .controls button.active { color:var(--accent); }
        .controls .main-play { width:38px; height:38px; border-radius:50%; display:grid; place-items:center; background:#fff; color:#000; font-size:1.2rem; }
        .pl-bar { display:flex; align-items:center; gap:8px; width:100%; max-width:420px; font-size:.68rem; color:var(--muted2); }
        .track { flex:1; height:4px; border-radius:4px; background:#3a3a3a; overflow:hidden; cursor:pointer; }
        .track-fill { height:100%; width:0; background:var(--txt); transition:width .2s linear; }
        .volume { width:255px; display:flex; justify-content:flex-end; align-items:center; gap:10px; color:var(--muted); }
        .vol-line { width:90px; height:4px; border-radius:5px; background:#444; overflow:hidden; cursor:pointer; }
        .vol-fill { height:100%; width:100%; background:#fff; }

        .backdrop { position:fixed; inset:0; z-index:100; display:none; align-items:center; justify-content:center; padding:20px; background:rgba(0,0,0,.72); backdrop-filter:blur(6px); }
        .backdrop.show { display:flex; }
        .modal { width:min(410px,100%); padding:30px; border:1px solid var(--line); border-radius:20px; text-align:center; background:#16161f; }
        .modal-icon { width:61px; height:61px; margin:0 auto 17px; border-radius:50%; display:grid; place-items:center; background:linear-gradient(135deg,var(--accent),var(--pink)); font-size:1.5rem; }
        .modal p { margin-top:10px; color:var(--muted); line-height:1.6; }
        .modal button { width:100%; height:44px; margin-top:22px; border:0; border-radius:12px; color:#fff; cursor:pointer; background:linear-gradient(135deg,var(--accent),var(--pink)); font-weight:800; }
        @@keyframes rise { from { opacity:0; transform:translateY(18px); } to { opacity:1; transform:none; } }
        @@media(max-width:1000px) { .shell { grid-template-columns:minmax(0,1fr); } .sidebar { display:none; } .volume { display:none; } }
        @@media(max-width:650px) { .topbar,.hero,.content { padding-left:16px; padding-right:16px; } .pkg { padding:8px 10px; } .genre-picker { padding:20px 16px; } .picker-hint { display:none; } .chips { display:flex; overflow-x:auto; margin-right:-16px; padding:2px 16px 10px 0; scroll-snap-type:x mandatory; } .chip { flex:0 0 125px; scroll-snap-align:start; } .grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:21px 12px; } .play { opacity:1; transform:none; width:40px; height:40px; } .now { width:160px; } .controls button:not(.main-play) { display:none; } }
    </style>
</head>
<body>
    <div class="shell">
        <aside class="sidebar">
            <div class="side-box">
                <a class="brand" href="/Home/Index"><span class="brand-mark"><i class="bi bi-broadcast"></i></span>Echoa</a>
                <a class="nav-item" href="/Home/Index"><i class="bi bi-house-door"></i>Ana sayfa</a>
                <a class="nav-item" href="/Artist/ArtistListV2"><i class="bi bi-person-badge"></i>Sanatçılar</a>
                <a class="nav-item active" href="/Genre/GenreList"><i class="bi bi-grid"></i>Türler</a>
                <a class="nav-item" href="/Song/Charts"><i class="bi bi-music-note-list"></i>Şarkılar</a>
                <a class="nav-item" href="/Song/History"><i class="bi bi-clock-history"></i>Geçmiş</a>
                <a class="nav-item" href="/Artist/Followed"><i class="bi bi-person-heart"></i>Takip Ettiklerim</a>
                <a class="nav-item" href="/Song/Favorites"><i class="bi bi-heart"></i>Beğendiklerim</a>
                <a class="nav-item" href="/Playlist/Index"><i class="bi bi-collection-play"></i>Çalma Listelerim</a>
            </div>
            <div class="side-feature"><div class="side-icon"><i class="bi bi-vinyl"></i></div><h3>Moduna göre dinle</h3><p>Türünü seç, Echoa senin için doğru ritmi öne çıkarsın.</p></div>
        </aside>

        <main class="main" id="main">
            <div class="topbar" id="topbar"><div class="search"><i class="bi bi-search"></i><input id="search" placeholder="Şarkı veya sanatçı ara" /></div><div class="spacer"></div><div class="pkg"><i class="bi bi-gem"></i>&nbsp; @Model.UserPackageName</div><div class="user-menu" id="userMenu"><div class="avatar" id="avatarBtn"><i class="bi bi-person-fill"></i></div><div class="user-dropdown" id="userDropdown">@if ((bool)(ViewBag.IsAdmin ?? false)) { <a class="user-dropdown-admin" href="/Admin/Index"><i class="bi bi-gear"></i>Admin Paneli</a> }<a class="user-dropdown-logout" href="/Login/Logout"><i class="bi bi-box-arrow-right"></i>Çıkış yap</a></div></div></div>
            <section class="hero"><div class="eyebrow">Müzik koleksiyonu</div><h1>Türünü seç.<br />Ritmini bul.</h1><p>Ruh hâline en uygun müziği keşfet. Türler arasında gezin, sevdiğin şarkıya dokun ve dinlemeye başla.</p><div class="hero-meta"><span>@Model.Genres.Count tür</span><span>@Model.Songs.Count şarkı</span></div></section>
            <section class="content">
                <div class="genre-picker">
                    <div class="picker-head"><div class="picker-icon"><i class="bi bi-soundwave"></i></div><div><div class="picker-kicker">Müziğini filtrele</div><div class="picker-title">Bir tür seç</div></div><span class="picker-hint">Ruh hâline uygun şarkıları anında keşfet</span></div>
                    <div class="chips" id="chips"><button class="chip active" data-genre="all"><i class="bi bi-grid-fill"></i>Tüm türler</button>@foreach(var genre in Model.Genres){<button class="chip" data-genre="@genre.GenreName.ToLowerInvariant()"><i class="bi bi-music-note"></i>@genre.GenreName</button>}</div>
                </div>
                <div class="section-head"><h2 id="songHeading">Tüm şarkılar</h2><span class="count" id="resultCount">@songs.Count şarkı</span></div>
                <div class="grid" id="songGrid">
                    @for(var i=0;i<songs.Count;i++)
                    {
                        var song=songs[i]; var locked=Model.UserPackageLevel<song.PackageLevel;
                        <article class="song" style="animation-delay:@(i*35)ms" data-genre="@song.GenreName.ToLowerInvariant()" data-name="@song.SongName.ToLowerInvariant()" data-artist="@song.ArtistName.ToLowerInvariant()">
                            <div class="cover">@if(!string.IsNullOrWhiteSpace(song.CoverImageUrl)){<img src="@song.CoverImageUrl" alt="@song.SongName kapağı" />}else{<div class="fallback">@song.SongName.Substring(0,1)</div>}@if(locked){<span class="lock"><i class="bi bi-lock-fill"></i></span>}<button class="play listen" data-id="@song.SongId" data-name="@song.SongName" data-artist="@song.ArtistName" data-package="@song.PackageName" type="button"><i class="bi @(locked?"bi-lock-fill":"bi-play-fill")"></i></button></div>
                            <h3 class="song-title">@song.SongName</h3><div class="song-sub">@song.ArtistName</div><div class="song-meta"><span class="genre">@song.GenreName</span><span class="badge">@song.PackageName</span></div>
                        </article>
                    }
                </div>
                <div class="empty" id="empty"><i class="bi bi-music-note-beamed"></i>Bu filtreyle eşleşen şarkı bulunamadı.</div>
            </section>
        </main>

        <div class="player"><div class="now"><div class="now-art"><i class="bi bi-music-note-beamed"></i></div><div style="min-width:0"><div class="now-name" id="nowName">Bir şarkı seç</div><div class="now-artist" id="nowArtist">Çalan bir şey yok</div></div></div><div class="controls"><div class="controls-row"><button id="shuffleBtn"><i class="bi bi-shuffle"></i></button><button id="mainPrev"><i class="bi bi-skip-start-fill"></i></button><button class="main-play" id="mainPlay"><i class="bi bi-play-fill" id="mainIcon"></i></button><button id="mainNext"><i class="bi bi-skip-end-fill"></i></button><button id="repeatBtn"><i class="bi bi-repeat"></i></button></div><div class="pl-bar"><span id="tCur">0:00</span><div class="track" id="track"><div class="track-fill" id="trackFill"></div></div><span id="tEnd">0:00</span></div></div><div class="volume"><i class="bi bi-volume-up" id="volIcon"></i><div class="vol-line" id="volTrack"><div class="vol-fill" id="volFill"></div></div></div></div>
    </div>
    <div class="backdrop" id="modal"><div class="modal"><div class="modal-icon"><i class="bi bi-lock-fill"></i></div><h3>Paketini yükselt</h3><p id="modalText">Mevcut paketiniz bu şarkıyı desteklememektedir. Lütfen paketinizi yükseltin.</p><button id="modalClose">Anladım</button></div></div>
    <audio id="audio"></audio>
    <script>
        var main=document.getElementById('main'),topbar=document.getElementById('topbar'); main.addEventListener('scroll',()=>topbar.classList.toggle('stuck',main.scrollTop>8));
        var avatarBtn=document.getElementById('avatarBtn'),userDropdown=document.getElementById('userDropdown');
        if(avatarBtn&&userDropdown){avatarBtn.addEventListener('click',e=>{e.stopPropagation();userDropdown.classList.toggle('show');});document.addEventListener('click',()=>userDropdown.classList.remove('show'));}
        var cards=[...document.querySelectorAll('.song')],search=document.getElementById('search'),empty=document.getElementById('empty'),count=document.getElementById('resultCount'); var selected='all';
        function filter(){var q=search.value.trim().toLowerCase();var shown=0;cards.forEach(c=>{var ok=(selected==='all'||c.dataset.genre===selected)&&(!q||c.dataset.name.includes(q)||c.dataset.artist.includes(q));c.classList.toggle('hidden',!ok);if(ok)shown++;});empty.style.display=shown?'none':'block';count.textContent=shown+' şarkı';}
        search.addEventListener('input',filter); document.getElementById('chips').addEventListener('click',e=>{var b=e.target.closest('.chip');if(!b)return;document.querySelectorAll('.chip').forEach(x=>x.classList.remove('active'));b.classList.add('active');selected=b.dataset.genre;document.getElementById('songHeading').textContent=selected==='all'?'Tüm şarkılar':b.textContent.trim()+' şarkıları';filter();document.getElementById('songHeading').scrollIntoView({behavior:'smooth',block:'center'});});
        var modal=document.getElementById('modal'),modalText=document.getElementById('modalText'),audio=document.getElementById('audio'),icon=document.getElementById('mainIcon');
        document.getElementById('modalClose').onclick=()=>modal.classList.remove('show'); modal.onclick=e=>{if(e.target===modal)modal.classList.remove('show');};
        var trackEl=document.getElementById('track'),trackFill=document.getElementById('trackFill'),tCur=document.getElementById('tCur'),tEnd=document.getElementById('tEnd');
        function fmt(s){var m=Math.floor(s/60),r=Math.floor(s%60);return m+':'+(r<10?'0'+r:r);}
        audio.addEventListener('timeupdate',()=>{if(audio.duration){trackFill.style.width=Math.round((audio.currentTime/audio.duration)*100)+'%';}tCur.textContent=fmt(audio.currentTime);});
        audio.addEventListener('loadedmetadata',()=>{tEnd.textContent=fmt(audio.duration);});
        trackEl.addEventListener('click',function(e){if(!audio.duration)return;var r=this.getBoundingClientRect();audio.currentTime=((e.clientX-r.left)/r.width)*audio.duration;});
        var volTrack=document.getElementById('volTrack'),volFill=document.getElementById('volFill'),volIcon=document.getElementById('volIcon');
        function syncVol(){var pct=audio.muted?0:audio.volume*100;volFill.style.width=pct+'%';volIcon.className='bi '+(pct==0?'bi-volume-mute':(pct<50?'bi-volume-down':'bi-volume-up'));}
        volTrack.addEventListener('click',function(e){var r=this.getBoundingClientRect();audio.volume=Math.min(1,Math.max(0,(e.clientX-r.left)/r.width));audio.muted=false;});
        volIcon.addEventListener('click',function(){audio.muted=!audio.muted;});
        audio.addEventListener('volumechange',syncVol);
        syncVol();
        async function listen(btn){const response=await fetch('/Song/Listen/'+btn.dataset.id,{method:'POST'});if(response.status===403){modalText.textContent=btn.dataset.name+' şarkısı '+btn.dataset.package+' paketine ait. Mevcut paketiniz bu şarkıyı desteklememektedir.';modal.classList.add('show');return;}if(response.status===401){location.href='/Login/SignIn';return;}if(!response.ok)return;const data=await response.json();document.getElementById('nowName').textContent=data.songName||btn.dataset.name;document.getElementById('nowArtist').textContent=data.artistName||btn.dataset.artist;icon.className='bi bi-pause-fill';if(window.spaSetNowPlaying){window.spaSetNowPlaying(data.songName||btn.dataset.name,data.artistName||btn.dataset.artist);}currentIndex=playlist.findIndex(p=>p.id===btn.dataset.id);if(data.audioUrl){audio.src=data.audioUrl;audio.play().catch(()=>{});}}
        document.querySelectorAll('.listen').forEach(btn=>btn.addEventListener('click',()=>listen(btn))); document.getElementById('mainPlay').onclick=()=>{if(!audio.src)return;if(audio.paused){audio.play();icon.className='bi bi-pause-fill';}else{audio.pause();icon.className='bi bi-play-fill';}};

        var playlist=cards.map(c=>{var el=c.querySelector('.listen');return el?{id:el.dataset.id,name:el.dataset.name,artist:el.dataset.artist,pkg:el.dataset.package}:null;}).filter(Boolean);
        var currentIndex=-1;
        function playAt(i){if(i<0||i>=playlist.length)return;var item=playlist[i];listen({dataset:{id:item.id,name:item.name,artist:item.artist,package:item.pkg}});}
        var shuffleBtn=document.getElementById('shuffleBtn'),repeatBtn=document.getElementById('repeatBtn');
        var shuffleOn=false,repeatOn=false;
        shuffleBtn.addEventListener('click',()=>{shuffleOn=!shuffleOn;shuffleBtn.classList.toggle('active',shuffleOn);});
        repeatBtn.addEventListener('click',()=>{repeatOn=!repeatOn;repeatBtn.classList.toggle('active',repeatOn);});
        function pickNextIndex(){if(shuffleOn&&playlist.length>1){var i;do{i=Math.floor(Math.random()*playlist.length);}while(i===currentIndex);return i;}return currentIndex+1;}
        document.getElementById('mainPrev').addEventListener('click',()=>playAt(currentIndex-1));
        document.getElementById('mainNext').addEventListener('click',()=>playAt(pickNextIndex()));
        audio.addEventListener('ended',()=>{if(repeatOn){audio.currentTime=0;audio.play().catch(()=>{});return;}playAt(pickNextIndex());});

        (function () {
            var STORAGE_KEY = 'echoaNowPlaying';
            var audioEl = document.getElementById('audio');
            if (!audioEl) return;

            var saved = sessionStorage.getItem(STORAGE_KEY);
            if (!audioEl.src && saved) {
                try {
                    var state = JSON.parse(saved);
                    if (state.src) {
                        audioEl.src = state.src;
                        audioEl.currentTime = state.time || 0;
                        if (state.playing) {
                            audioEl.play().catch(function () { });
                            icon.className = 'bi bi-pause-fill';
                        }
                        var nowNameEl = document.getElementById('nowName');
                        var nowArtistEl = document.getElementById('nowArtist');
                        if (nowNameEl && state.name) { nowNameEl.textContent = state.name; }
                        if (nowArtistEl && state.artist) { nowArtistEl.textContent = state.artist; }
                    }
                } catch (e) { }
            }

            window.addEventListener('pagehide', function () {
                if (!audioEl.src) return;
                sessionStorage.setItem(STORAGE_KEY, JSON.stringify({
                    src: audioEl.src,
                    time: audioEl.currentTime,
                    playing: !audioEl.paused,
                    name: (document.getElementById('nowName') || document.getElementById('npName') || {}).textContent,
                    artist: (document.getElementById('nowArtist') || document.getElementById('npSub') || {}).textContent
                }));
            });
        })();
    </script>
</body>
</html>
