@model JwtMusicNight.WebUI.Dtos.PlaylistDetailDto
@{
    Layout = null;
    ViewData["Title"] = Model.Name + " – Echoa";
    var userLevel = (int)ViewBag.PackageLevel;
    var userPkg = (string)ViewBag.PackageName;
    var availableSongs = ViewBag.AvailableSongs as List<JwtMusicNight.WebUI.Dtos.ResultSongDto> ?? new();
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <script src="/js/spa-router.js?v=20261028-playerbar"></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <style>
        :root {
            --bg: #000;
            --panel: #121212;
            --panel-2: #181818;
            --panel-3: #232323;
            --line: rgba(255,255,255,.09);
            --txt: #fff;
            --txt-2: #b3b3b3;
            --txt-3: #6a6a6a;
            --accent: #a855f7;
            --accent-2: #ec4899;
            --ok: #1ed760;
            --danger: #f43f5e;
            --player-h: 76px;
            --rail-w: 258px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { height: 100%; }

        body {
            background: var(--bg);
            color: var(--txt);
            font-family: 'Figtree', system-ui, sans-serif;
            overflow: hidden;
            width: 100%;
        }

        a { color: inherit; text-decoration: none; }

        .shell {
            display: grid;
            grid-template-columns: var(--rail-w) minmax(0, 1fr);
            grid-template-rows: 1fr var(--player-h);
            width: 100%;
            max-width: 100vw;
            height: 100dvh;
            gap: 10px;
            padding: 10px;
            overflow: hidden;
        }

        .rail { grid-row: 1; display: flex; flex-direction: column; gap: 10px; min-height: 0; }
        .rail-box { background: var(--panel); border-radius: 10px; padding: 18px 14px; }

        .brand {
            display: flex; align-items: center; gap: 10px;
            padding: 4px 8px 14px; font-weight: 800; font-size: 1.18rem; letter-spacing: -.5px;
        }

        .brand-dot {
            width: 26px; height: 26px; border-radius: 50%;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            display: grid; place-items: center; font-size: .85rem;
        }

        .nav-item {
            display: flex; align-items: center; gap: 15px; padding: 11px 12px; border-radius: 7px;
            color: var(--txt-2); font-weight: 600; font-size: .92rem; position: relative;
            transition: color .18s, background .18s;
        }

        .nav-item i { font-size: 1.22rem; }
        .nav-item:hover { color: var(--txt); }
        .nav-item.on { color: var(--txt); background: var(--panel-3); }

        .nav-item::before {
            content: ''; position: absolute; left: 0; top: 50%; width: 3px; height: 0; border-radius: 3px;
            background: linear-gradient(var(--accent), var(--accent-2));
            transform: translateY(-50%); transition: height .28s cubic-bezier(.22,1,.36,1);
        }

        .nav-item.on::before, .nav-item:hover::before { height: 62%; }

        .main {
            grid-row: 1; min-width: 0; min-height: 0; position: relative;
            background: var(--panel); border-radius: 10px; overflow-x: hidden; overflow-y: auto;
        }

        .topbar {
            position: sticky; top: 0; z-index: 20; display: flex; align-items: center; gap: 14px;
            padding: 16px 32px; background: rgba(18,18,18,.82); backdrop-filter: blur(18px); border-bottom: 1px solid transparent;
        }

        .topbar.stuck { border-bottom-color: var(--line); }

        .back-btn {
            width: 32px; height: 32px; border-radius: 50%; border: none; background: rgba(0,0,0,.55);
            color: var(--txt-2); display: grid; place-items: center; cursor: pointer; flex-shrink: 0;
        }
        .back-btn:hover { color: var(--txt); }

        .spacer { flex: 1; }

        .pkg-pill {
            display: flex; align-items: center; gap: 7px; height: 32px; padding: 0 14px; border-radius: 50px;
            background: linear-gradient(135deg, var(--accent), var(--accent-2)); font-size: .8rem; font-weight: 700;
        }

        .avatar-pill {
            width: 32px; height: 32px; border-radius: 50%; background: var(--panel-3);
            display: grid; place-items: center; font-size: .95rem; color: var(--txt-2);
            cursor: pointer;
        }

        .user-menu { position: relative; }
        .user-dropdown {
            position: absolute; top: calc(100% + 10px); right: 0; min-width: 180px;
            background: var(--panel-2); border: 1px solid var(--line); border-radius: 12px;
            padding: 8px; display: none; flex-direction: column; gap: 4px; z-index: 50;
            box-shadow: 0 16px 40px rgba(0,0,0,.4);
        }
        .user-dropdown.show { display: flex; }
        .user-dropdown-logout {
            display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-radius: 8px;
            font-size: .82rem; color: var(--txt); cursor: pointer;
        }
        .user-dropdown-logout:hover { background: var(--panel-3); color: var(--danger); }
        .user-dropdown-admin { display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-radius: 8px; font-size: .82rem; color: var(--txt); cursor: pointer; }
        .user-dropdown-admin:hover { background: var(--panel-3); color: var(--accent); }

        .hero { position: relative; overflow: hidden; padding: 38px 32px 42px; }

        .orb { position: absolute; border-radius: 50%; filter: blur(70px); pointer-events: none; z-index: 0; }
        .orb-a { width: 340px; height: 340px; top: -140px; left: -60px; background: rgba(168,85,247,.45); animation: floatOrb 17s ease-in-out infinite; }
        .orb-b { width: 280px; height: 280px; top: -60px; left: 46%; background: rgba(236,72,153,.3); animation: floatOrb 21s ease-in-out infinite reverse; }
        .hero > *:not(.orb) { position: relative; z-index: 1; }

        .hero-kicker { font-size: .76rem; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; color: var(--txt-2); margin-bottom: 10px; }
        .hero-title { font-size: clamp(2.4rem, 6vw, 4.2rem); font-weight: 800; letter-spacing: -2.5px; line-height: 1.02; }

        .hero-meta { margin-top: 14px; font-size: .9rem; color: var(--txt-2); display: flex; align-items: center; gap: 8px; }

        .sec { width: 100%; min-width: 0; padding: 12px 32px 38px; overflow: hidden; }

        /* ---------- SONG LIST ---------- */
        .thead {
            display: grid; grid-template-columns: 38px minmax(0, 1fr) 150px 110px 44px; gap: 14px; padding: 0 12px 10px;
            font-size: .74rem; font-weight: 700; letter-spacing: 1.1px; text-transform: uppercase;
            color: var(--txt-3); border-bottom: 1px solid var(--line);
        }

        .trow {
            display: grid; grid-template-columns: 38px minmax(0, 1fr) 150px 110px 44px; gap: 14px; align-items: center;
            min-width: 0;
            padding: 9px 12px; border-radius: 7px; transition: background .18s;
            animation: fadeUp .5s cubic-bezier(.22,1,.36,1) both;
        }

        .trow:hover { background: var(--panel-2); }
        .trow.locked { opacity: .52; }

        .t-num { color: var(--txt-3); font-size: .92rem; text-align: center; position: relative; }
        .trow:hover .t-num .n { display: none; }
        .t-num .p { display: none; color: var(--txt); font-size: 1.05rem; cursor: pointer; }
        .trow:hover .t-num .p { display: block; }

        .t-main { display: flex; align-items: center; gap: 13px; min-width: 0; }

        .t-art-fb {
            width: 42px; height: 42px; border-radius: 5px; flex-shrink: 0; display: grid; place-items: center;
            overflow: hidden; font-size: 1rem; font-weight: 800; background: linear-gradient(135deg, var(--accent), var(--accent-2));
        }

        .t-art-fb img { width: 100%; height: 100%; object-fit: cover; }

        .t-title {
            font-size: .95rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
            display: flex; align-items: center; gap: 7px;
        }

        .t-title .bi-lock-fill { color: var(--txt-3); font-size: .8rem; }
        .t-sub { font-size: .8rem; color: var(--txt-3); margin-top: 2px; }

        .badge {
            display: inline-flex; align-items: center; gap: 5px; height: 24px; padding: 0 11px;
            border-radius: 50px; font-size: .74rem; font-weight: 800; letter-spacing: .3px;
        }

        .b-basic { background: rgba(255,255,255,.1); color: var(--txt-2); }
        .b-gold { background: rgba(245,158,11,.16); color: #fbbf24; }
        .b-premium { background: rgba(168,85,247,.18); color: #c084fc; }
        .b-elit { background: linear-gradient(120deg, var(--accent), var(--accent-2)); color: #fff; }

        .t-dur { font-size: .86rem; color: var(--txt-3); text-align: right; }

        .remove-icon {
            width: 30px; height: 30px; border-radius: 50%; border: none; background: transparent;
            color: var(--txt-3); display: grid; place-items: center; cursor: pointer; font-size: 1rem;
        }
        .remove-icon:hover { color: var(--danger); background: var(--panel-3); }

        .empty { text-align: center; padding: 50px 20px; color: var(--txt-3); }
        .empty i { font-size: 2.3rem; display: block; margin-bottom: 12px; }

        .add-section { margin: 4px 32px 45px; padding: 24px; border: 1px solid var(--line); border-radius: 18px; background: linear-gradient(145deg,rgba(168,85,247,.1),var(--panel-2) 42%); }
        .add-head { display:flex; align-items:flex-end; justify-content:space-between; gap:18px; margin-bottom:20px; }
        .add-title { font-size:1.3rem; font-weight:800; } .add-copy { color:var(--txt-3); font-size:.82rem; margin-top:5px; }
        .song-search { position:relative; width:min(300px,100%); } .song-search i { position:absolute; left:13px; top:50%; transform:translateY(-50%); color:var(--txt-3); }
        .song-search input { width:100%; height:41px; padding:0 14px 0 39px; border:1px solid var(--line); border-radius:50px; background:var(--panel); color:var(--txt); outline:none; font-family:inherit; }
        .song-search input:focus { border-color:rgba(216,180,254,.5); }
        .available-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(245px,1fr)); gap:11px; }
        .available-card { min-width:0; display:grid; grid-template-columns:52px minmax(0,1fr) auto; gap:12px; align-items:center; padding:10px; border:1px solid var(--line); border-radius:13px; background:rgba(255,255,255,.025); }
        .available-card:hover { background:rgba(255,255,255,.055); border-color:rgba(255,255,255,.15); }
        .available-cover { width:52px; height:52px; border-radius:9px; overflow:hidden; display:grid; place-items:center; background:linear-gradient(135deg,var(--accent),var(--accent-2)); font-weight:800; }
        .available-cover img { width:100%; height:100%; object-fit:cover; }
        .available-name { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-size:.88rem; font-weight:700; }
        .available-meta { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-top:4px; color:var(--txt-3); font-size:.74rem; }
        .available-add { width:36px; height:36px; display:grid; place-items:center; border:0; border-radius:50%; background:#fff; color:#111; cursor:pointer; font-size:1.05rem; transition:.18s; }
        .available-add:hover { transform:scale(1.08); background:#d8b4fe; } .available-add:disabled { cursor:default; transform:none; background:var(--ok); }
        .catalog-empty { color:var(--txt-3); text-align:center; padding:30px 15px; grid-column:1/-1; }

        /* ---------- PLAYER ---------- */
        .player {
            grid-column: 1 / -1; grid-row: 2; min-width: 0; overflow: hidden;
            display: flex; align-items: center; gap: 16px; padding: 0 16px;
        }
        .np { display: flex; align-items: center; gap: 12px; width: 260px; min-width: 0; }

        .np-art {
            width: 54px; height: 54px; border-radius: 6px;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            display: grid; place-items: center; font-size: 1.3rem; flex-shrink: 0; transition: transform .4s;
        }

        .np-art.spin { animation: spin 6s linear infinite; }

        .np-name { font-size: .88rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .np-sub { font-size: .76rem; color: var(--txt-3); display: flex; align-items: center; gap: 8px; }

        .eq { display: none; align-items: flex-end; gap: 2px; width: 20px; height: 15px; }
        .eq.on { display: flex; }
        .eq span { flex: 1; background: var(--ok); border-radius: 1px; animation: eqBar .85s ease-in-out infinite; }
        .eq span:nth-child(2) { animation-delay: .18s; }
        .eq span:nth-child(3) { animation-delay: .36s; }
        .eq span:nth-child(4) { animation-delay: .54s; }

        .pl-center { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 8px; }
        .pl-btns { display: flex; align-items: center; gap: 20px; }
        .pl-btns button { border: none; background: transparent; color: var(--txt-2); font-size: 1.05rem; cursor: pointer; }
        .pl-btns button:hover { color: var(--txt); }
        .pl-btns button.active { color: var(--accent); }

        .pl-play {
            width: 36px; height: 36px; border-radius: 50%; background: var(--txt) !important; color: #000 !important;
            display: grid; place-items: center; font-size: 1.1rem !important; transition: transform .25s cubic-bezier(.34,1.56,.64,1);
        }

        .pl-play:hover { transform: scale(1.12); }

        .pl-bar { display: flex; align-items: center; gap: 10px; width: 100%; max-width: 520px; font-size: .7rem; color: var(--txt-3); }
        .track { flex: 1; height: 4px; border-radius: 4px; background: #4d4d4d; overflow: hidden; cursor: pointer; }
        .track-fill { height: 100%; width: 0; background: var(--txt); transition: width .2s linear; }

        .pl-right { display: flex; align-items: center; gap: 12px; width: 200px; justify-content: flex-end; color: var(--txt-2); font-size: 1rem; }
        .vol { width: 92px; height: 4px; border-radius: 4px; background: #4d4d4d; cursor: pointer; }
        .vol-fill { height: 100%; width: 100%; border-radius: 4px; background: var(--txt); }

        /* ---------- MODAL ---------- */
        .backdrop {
            position: fixed; inset: 0; z-index: 90; background: rgba(0,0,0,.72); backdrop-filter: blur(6px);
            display: none; align-items: center; justify-content: center; padding: 24px;
        }

        .backdrop.on { display: flex; animation: fadeIn .2s ease; }

        .modal-card {
            width: 100%; max-width: 412px; padding: 30px 28px 26px; border-radius: 18px; text-align: center;
            background: #16161f; border: 1px solid var(--line); animation: pop .38s cubic-bezier(.22,1,.36,1) both;
        }

        .modal-ico {
            width: 62px; height: 62px; margin: 0 auto 18px; border-radius: 50%; display: grid; place-items: center;
            font-size: 1.7rem; background: linear-gradient(135deg, var(--accent), var(--accent-2));
        }

        .modal-card h3 { font-size: 1.3rem; font-weight: 800; letter-spacing: -.5px; margin-bottom: 10px; }
        .modal-card p { font-size: .94rem; color: var(--txt-2); line-height: 1.6; }

        .modal-pkg {
            display: inline-flex; align-items: center; gap: 7px; margin-top: 16px; padding: 7px 14px;
            border-radius: 50px; background: rgba(255,255,255,.06); border: 1px solid var(--line);
            font-size: .82rem; color: var(--txt-2);
        }

        .modal-acts { display: flex; gap: 10px; margin-top: 24px; }
        .modal-acts button {
            flex: 1; height: 46px; border-radius: 12px; border: none; font-family: inherit;
            font-size: .93rem; font-weight: 800; cursor: pointer; transition: transform .2s, filter .2s;
        }

        .m-ghost { background: transparent; border: 1px solid var(--line) !important; color: var(--txt); }
        .m-ghost:hover { border-color: rgba(255,255,255,.4) !important; }
        .m-cta { background: linear-gradient(120deg, var(--accent), var(--accent-2)); color: #fff; }
        .m-cta:hover { transform: translateY(-2px); filter: brightness(1.12); }

        ::-webkit-scrollbar { width: 11px; }
        ::-webkit-scrollbar-thumb { background: #4a4a4a; border-radius: 6px; border: 3px solid transparent; background-clip: content-box; }

        @@keyframes fadeUp { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: translateY(0); } }
        @@keyframes floatOrb { 0%, 100% { transform: translate(0,0) scale(1); } 50% { transform: translate(38px,-26px) scale(1.14); } }
        @@keyframes spin { to { transform: rotate(360deg); } }
        @@keyframes eqBar { 0%, 100% { height: 22%; } 50% { height: 100%; } }
        @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @@keyframes pop { from { opacity: 0; transform: scale(.92); } to { opacity: 1; transform: scale(1); } }

        @@media (max-width: 1000px) {
            .shell { grid-template-columns: minmax(0, 1fr); }
            .rail { display: none; }
            .np, .pl-right { width: auto; }
            .pl-right { display: none; }
        }
        @@media (max-width:680px) { .add-section { margin-inline:16px; padding:18px; } .add-head { align-items:stretch; flex-direction:column; } .song-search { width:100%; } }

        @@media (max-width: 680px) {
            .topbar, .hero, .sec { padding-left: 16px; padding-right: 16px; }
            .pkg-pill { padding: 0 10px; }
            .hero-title { font-size: 2.7rem; }
            .thead { display: none; }
            .trow { grid-template-columns: 30px minmax(0, 1fr) auto 36px; gap: 9px; padding: 9px 4px; }
            .trow > div:nth-child(4) { display: none; }
            .badge { padding: 0 8px; }
            .player { padding: 0 10px; }
            .np { width: 150px; }
            .np-art { width: 44px; height: 44px; }
            .pl-btns button:not(.pl-play) { display: none; }
            .pl-bar { display: none; }
        }
    </style>
</head>
<body>
    <div class="shell">

        <aside class="rail">
            <div class="rail-box">
                <div class="brand">
                    <div class="brand-dot"><i class="bi bi-broadcast"></i></div>
                    Echoa
                </div>
                <a class="nav-item" href="/Home/Index"><i class="bi bi-house-door"></i>Ana sayfa</a>
                <a class="nav-item" href="/Artist/ArtistListV2"><i class="bi bi-person-badge"></i>Sanatçılar</a>
                <a class="nav-item" href="/Genre/GenreList"><i class="bi bi-collection"></i>Türler</a>
                <a class="nav-item" href="/Song/Charts"><i class="bi bi-music-note-list"></i>Şarkılar</a>
                <a class="nav-item" href="/Song/History"><i class="bi bi-clock-history"></i>Geçmiş</a>
                <a class="nav-item" href="/Artist/Followed"><i class="bi bi-person-heart"></i>Takip Ettiklerim</a>
                <a class="nav-item" href="/Song/Favorites"><i class="bi bi-heart"></i>Beğendiklerim</a>
                <a class="nav-item on" href="/Playlist/Index"><i class="bi bi-collection-play"></i>Çalma Listelerim</a>
            </div>
        </aside>

        <main class="main" id="main">

            <div class="topbar" id="topbar">
                <a class="back-btn" href="/Playlist/Index" aria-label="Geri"><i class="bi bi-arrow-left"></i></a>
                <div class="spacer"></div>
                <a class="pkg-pill" href="/Package/Index" title="Paketleri incele"><i class="bi bi-gem"></i>@userPkg</a>
                <div class="user-menu" id="userMenu">
                    <div class="avatar-pill" id="avatarBtn"><i class="bi bi-person-fill"></i></div>
                    <div class="user-dropdown" id="userDropdown">
                        @if ((bool)(ViewBag.IsAdmin ?? false))
                        {
                            <a class="user-dropdown-admin" href="/Admin/Index"><i class="bi bi-gear"></i>Admin Paneli</a>
                        }
                        <a class="user-dropdown-logout" data-no-route href="/Login/Logout"><i class="bi bi-box-arrow-right"></i>Çıkış yap</a>
                    </div>
                </div>
            </div>

            <section class="hero">
                <div class="orb orb-a"></div>
                <div class="orb orb-b"></div>
                <div class="hero-kicker">Çalma listesi</div>
                <h1 class="hero-title">@Model.Name</h1>
                <div class="hero-meta"><span>@Model.Songs.Count şarkı</span></div>
            </section>

            <section class="sec">
                @if (Model.Songs.Count == 0)
                {
                    <div class="empty"><i class="bi bi-music-note-beamed"></i>Bu listede henüz şarkı yok.</div>
                }
                else
                {
                    <div class="thead">
                        <div>#</div>
                        <div>Başlık</div>
                        <div>Paket</div>
                        <div style="text-align:right"><i class="bi bi-clock"></i></div>
                        <div></div>
                    </div>
                    <div id="grid">
                        @for (int i = 0; i < Model.Songs.Count; i++)
                        {
                            var s = Model.Songs[i];
                            var locked = userLevel < s.PackageLevel;
                            <div class="trow @(locked ? "locked" : "")"
                                 style="animation-delay:@(i * 30)ms"
                                 data-href="/Song/SongDetail/@s.SongId">
                                <div class="t-num">
                                    <span class="n">@(i + 1)</span>
                                    <i class="bi bi-play-fill p listen" data-id="@s.SongId" data-name="@s.SongName" data-artist="@s.ArtistName" data-pkg="@s.PackageName"></i>
                                </div>
                                <div class="t-main">
                                    <div class="t-art-fb">
                                        @if (!string.IsNullOrWhiteSpace(s.CoverImageUrl))
                                        {
                                            <img src="@s.CoverImageUrl" alt="" />
                                        }
                                        else
                                        {
                                            @s.SongName.Substring(0, 1)
                                        }
                                    </div>
                                    <div style="min-width:0">
                                        <div class="t-title">
                                            <span>@s.SongName</span>
                                            @if (locked)
                                            {
                                                <i class="bi bi-lock-fill" title="@s.PackageName paketi gerekiyor"></i>
                                            }
                                        </div>
                                        <div class="t-sub">@s.ArtistName</div>
                                    </div>
                                </div>
                                <div><span class="badge b-@s.PackageName.ToLower()">@s.PackageName</span></div>
                                <div class="t-dur">@s.Duration.ToString("mm\\:ss")</div>
                                <button class="remove-icon" type="button" data-id="@s.SongId" title="Listeden çıkar"><i class="bi bi-x-lg"></i></button>
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="add-section">
                <div class="add-head">
                    <div><div class="add-title">Listene şarkı ekle</div><div class="add-copy"><i class="bi bi-gem"></i> @userPkg paketinin erişebildiği ve bu listede bulunmayan şarkılar.</div></div>
                    @if (availableSongs.Count > 0) { <label class="song-search"><i class="bi bi-search"></i><input id="availableSearch" type="search" placeholder="Şarkı veya sanatçı ara" /></label> }
                </div>
                <div class="available-grid" id="availableGrid">
                    @if (availableSongs.Count == 0)
                    {
                        <div class="catalog-empty"><i class="bi bi-check2-circle"></i> Paketine uygun eklenebilecek başka şarkı kalmadı.</div>
                    }
                    else
                    {
                        @foreach (var song in availableSongs)
                        {
                            <div class="available-card" data-search="@($"{song.SongName} {song.ArtistName} {song.GenreName}".ToLowerInvariant())">
                                <div class="available-cover">@if (!string.IsNullOrWhiteSpace(song.CoverImageUrl)) { <img src="@song.CoverImageUrl" alt="" /> } else { @song.SongName.Substring(0, 1) }</div>
                                <div style="min-width:0"><div class="available-name">@song.SongName</div><div class="available-meta">@song.ArtistName · @song.GenreName · @song.PackageName</div></div>
                                <button class="available-add" type="button" data-id="@song.SongId" title="Listeye ekle"><i class="bi bi-plus-lg"></i></button>
                            </div>
                        }
                    }
                </div>
            </section>

        </main>

        <div class="player">
            <div class="np">
                <div class="np-art" id="npArt"><i class="bi bi-music-note-beamed"></i></div>
                <div style="min-width:0">
                    <div class="np-name" id="npName">Bir şarkı seç</div>
                    <div class="np-sub">
                        <span id="npSub">Çalan bir şey yok</span>
                        <span class="eq" id="eq"><span></span><span></span><span></span><span></span></span>
                    </div>
                </div>
            </div>
            <div class="pl-center">
                <div class="pl-btns">
                    <button id="shuffleBtn" aria-label="Karıştır"><i class="bi bi-shuffle"></i></button>
                    <button id="plPrev" aria-label="Önceki"><i class="bi bi-skip-start-fill"></i></button>
                    <button class="pl-play" id="plPlay" aria-label="Çal"><i class="bi bi-play-fill" id="plIcon"></i></button>
                    <button id="plNext" aria-label="Sonraki"><i class="bi bi-skip-end-fill"></i></button>
                    <button id="repeatBtn" aria-label="Tekrarla"><i class="bi bi-repeat"></i></button>
                </div>
                <div class="pl-bar">
                    <span id="tCur">0:00</span>
                    <div class="track" id="track"><div class="track-fill" id="trackFill"></div></div>
                    <span id="tEnd">0:00</span>
                </div>
            </div>
            <div class="pl-right">
                <i class="bi bi-volume-up" id="volIcon"></i>
                <div class="vol" id="volTrack"><div class="vol-fill" id="volFill"></div></div>
            </div>
        </div>

    </div>

    <div class="backdrop" id="lockModal">
        <div class="modal-card">
            <div class="modal-ico"><i class="bi bi-lock-fill"></i></div>
            <h3>Bu şarkı paketinde yok</h3>
            <p id="lockMsg">Mevcut paketiniz bu şarkıyı desteklememektedir. Lütfen paketinizi yükseltin.</p>
            <div class="modal-pkg">
                <i class="bi bi-gem"></i>
                Paketin: <strong>&nbsp;@userPkg</strong>
            </div>
            <div class="modal-acts">
                <button class="m-ghost" id="lockClose" type="button">Kapat</button>
                <button class="m-cta" type="button">Paketi yükselt</button>
            </div>
        </div>
    </div>

    <audio id="audio"></audio>

    <script>
        var main = document.getElementById('main');
        var topbar = document.getElementById('topbar');
        main.addEventListener('scroll', function () {
            topbar.classList.toggle('stuck', main.scrollTop > 8);
        });

        var avatarBtn = document.getElementById('avatarBtn');
        var userDropdown = document.getElementById('userDropdown');
        if (avatarBtn && userDropdown) {
            avatarBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                userDropdown.classList.toggle('show');
            });
            document.addEventListener('click', function () { userDropdown.classList.remove('show'); });
        }

        var rows = Array.prototype.slice.call(document.querySelectorAll('#grid .trow'));
        var availableSearch = document.getElementById('availableSearch');
        if (availableSearch) {
            availableSearch.addEventListener('input', function () {
                var term = this.value.trim().toLocaleLowerCase('tr-TR');
                document.querySelectorAll('#availableGrid .available-card').forEach(function (card) {
                    card.style.display = !term || (card.dataset.search || '').toLocaleLowerCase('tr-TR').includes(term) ? '' : 'none';
                });
            });
        }

        document.querySelectorAll('.available-add').forEach(function (button) {
            button.addEventListener('click', async function () {
                var addButton = this;
                addButton.disabled = true;
                addButton.innerHTML = '<i class="bi bi-hourglass-split"></i>';
                var response = await fetch('/Playlist/AddSong?playlistId=@Model.PlaylistId&songId=' + addButton.dataset.id, { method: 'POST' });
                if (!response.ok) {
                    addButton.disabled = false;
                    addButton.innerHTML = '<i class="bi bi-plus-lg"></i>';
                    return;
                }
                addButton.innerHTML = '<i class="bi bi-check-lg"></i>';
                if (window.spaNavigate) { window.spaNavigate('/Playlist/Detail/@Model.PlaylistId'); }
                else { window.location.reload(); }
            });
        });

        var modal = document.getElementById('lockModal');
        var lockMsg = document.getElementById('lockMsg');
        document.getElementById('lockClose').addEventListener('click', function () { modal.classList.remove('on'); });
        modal.addEventListener('click', function (e) { if (e.target === modal) { modal.classList.remove('on'); } });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { modal.classList.remove('on'); } });

        var audio = document.getElementById('audio');
        var eq = document.getElementById('eq');
        var npArt = document.getElementById('npArt');
        var npName = document.getElementById('npName');
        var npSub = document.getElementById('npSub');
        var plPlay = document.getElementById('plPlay');
        var plIcon = document.getElementById('plIcon');
        var trackEl = document.getElementById('track');
        var trackFill = document.getElementById('trackFill');
        var tCur = document.getElementById('tCur');
        var tEnd = document.getElementById('tEnd');
        var plPrev = document.getElementById('plPrev');
        var plNext = document.getElementById('plNext');

        function fmt(s) {
            var m = Math.floor(s / 60), r = Math.floor(s % 60);
            return m + ':' + (r < 10 ? '0' + r : r);
        }

        function setPlaying(on) {
            eq.classList.toggle('on', on);
            npArt.classList.toggle('spin', on);
            plIcon.className = on ? 'bi bi-pause-fill' : 'bi bi-play-fill';
        }

        audio.addEventListener('play', function () { setPlaying(true); });
        audio.addEventListener('pause', function () { setPlaying(false); });
        audio.addEventListener('timeupdate', function () {
            if (audio.duration) { trackFill.style.width = Math.round((audio.currentTime / audio.duration) * 100) + '%'; }
            tCur.textContent = fmt(audio.currentTime);
        });
        audio.addEventListener('loadedmetadata', function () { tEnd.textContent = fmt(audio.duration); });

        var shuffleBtn = document.getElementById('shuffleBtn');
        var repeatBtn = document.getElementById('repeatBtn');
        var shuffleOn = false, repeatOn = false;

        shuffleBtn.addEventListener('click', function () {
            shuffleOn = !shuffleOn;
            shuffleBtn.classList.toggle('active', shuffleOn);
        });
        repeatBtn.addEventListener('click', function () {
            repeatOn = !repeatOn;
            repeatBtn.classList.toggle('active', repeatOn);
        });

        function pickNextIndex() {
            if (shuffleOn && playlist.length > 1) {
                var i;
                do { i = Math.floor(Math.random() * playlist.length); } while (i === currentIndex);
                return i;
            }
            return currentIndex + 1;
        }

        audio.addEventListener('ended', function () {
            if (repeatOn) { audio.currentTime = 0; audio.play().catch(function () { }); return; }
            playAt(pickNextIndex());
        });

        plPlay.addEventListener('click', function () {
            if (!audio.src) { return; }
            if (audio.paused) { audio.play().catch(function () { }); } else { audio.pause(); }
        });

        trackEl.addEventListener('click', function (e) {
            if (!audio.duration) { return; }
            var r = this.getBoundingClientRect();
            audio.currentTime = ((e.clientX - r.left) / r.width) * audio.duration;
        });

        var volTrack = document.getElementById('volTrack');
        var volFill = document.getElementById('volFill');
        var volIcon = document.getElementById('volIcon');

        function syncVol() {
            var pct = audio.muted ? 0 : audio.volume * 100;
            volFill.style.width = pct + '%';
            volIcon.className = 'bi ' + (pct == 0 ? 'bi-volume-mute' : (pct < 50 ? 'bi-volume-down' : 'bi-volume-up'));
        }

        volTrack.addEventListener('click', function (e) {
            var r = this.getBoundingClientRect();
            audio.volume = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
            audio.muted = false;
        });
        volIcon.addEventListener('click', function () { audio.muted = !audio.muted; });
        audio.addEventListener('volumechange', syncVol);
        syncVol();

        var playlist = rows.map(function (row) {
            var el = row.querySelector('.listen');
            return el ? { id: el.dataset.id, name: el.dataset.name, artist: el.dataset.artist, pkg: el.dataset.pkg } : null;
        }).filter(Boolean);
        var currentIndex = -1;

        function playAt(i) {
            if (i < 0 || i >= playlist.length) { return; }
            var item = playlist[i];
            requestListen(item.id, item.name, item.artist, item.pkg);
        }

        plPrev.addEventListener('click', function () { playAt(currentIndex - 1); });
        plNext.addEventListener('click', function () { playAt(pickNextIndex()); });

        async function requestListen(id, name, artist, pkg) {
            var res = await fetch('/Song/Listen/' + id, { method: 'POST' });

            if (res.status === 403) {
                lockMsg.textContent = name + ' şarkısı ' + pkg + ' paketine ait. Mevcut paketiniz bu şarkıyı desteklememektedir. Lütfen paketinizi yükseltin.';
                modal.classList.add('on');
                return;
            }

            if (res.status === 401) {
                window.location.href = '/Login/SignIn';
                return;
            }

            if (!res.ok) { return; }

            var data = await res.json();
            npName.textContent = data.songName || name;
            npSub.textContent = data.artistName || artist;
            if (window.spaSetNowPlaying) { window.spaSetNowPlaying(data.songName || name, data.artistName || artist, data.coverImageUrl, data.songId || id); }
            currentIndex = playlist.findIndex(function (p) { return p.id === String(id); });

            if (data.audioUrl) {
                audio.src = data.audioUrl;
                audio.play().catch(function () { });
            }
        }

        document.querySelectorAll('.listen').forEach(function (el) {
            el.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                requestListen(this.dataset.id, this.dataset.name, this.dataset.artist, this.dataset.pkg);
            });
        });

        var playlistId = @Model.PlaylistId;
        document.querySelectorAll('.remove-icon').forEach(function (btn) {
            btn.addEventListener('click', async function (e) {
                e.preventDefault();
                e.stopPropagation();
                await fetch('/Playlist/RemoveSong?playlistId=' + playlistId + '&songId=' + this.dataset.id, { method: 'POST' });
                var row = this.closest('.trow');
                if (row) { row.remove(); }
            });
        });

        document.querySelectorAll('.trow').forEach(function (row) {
            row.addEventListener('click', function (e) {
                if (e.target.closest('.listen') || e.target.closest('.remove-icon')) { return; }
                if (window.spaNavigate) { window.spaNavigate(this.dataset.href); }
                else { window.location.href = this.dataset.href; }
            });
            row.style.cursor = 'pointer';
        });

        (function () {
            var STORAGE_KEY = 'echoaNowPlaying';
            var audioEl = document.getElementById('audio');
            if (!audioEl) return;

            var saved = sessionStorage.getItem(STORAGE_KEY);
            if (!audioEl.src && saved) {
                try {
                    var state = JSON.parse(saved);
                    if (state.src) {
                        audioEl.src = state.src;
                        audioEl.currentTime = state.time || 0;
                        if (state.playing) {
                            audioEl.play().catch(function () { });
                        }
                        var npNameEl = document.getElementById('npName');
                        var npSubEl = document.getElementById('npSub');
                        if (npNameEl && state.name) { npNameEl.textContent = state.name; }
                        if (npSubEl && state.artist) { npSubEl.textContent = state.artist; }
                    }
                } catch (e) { }
            }

            window.addEventListener('pagehide', function () {
                if (!audioEl.src) return;
                sessionStorage.setItem(STORAGE_KEY, JSON.stringify({
                    src: audioEl.src,
                    time: audioEl.currentTime,
                    playing: !audioEl.paused,
                    name: (document.getElementById('npName') || {}).textContent,
                    artist: (document.getElementById('npSub') || {}).textContent
                }));
            });
        })();
    </script>
</body>
</html>
