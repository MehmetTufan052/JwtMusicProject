@model JwtMusicNight.WebUI.Dtos.RegisterDto
@{
    Layout = null;
    ViewData["Title"] = "Hesap oluştur – Echoa";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <style>
        :root {
            --bg: #07070c;
            --panel: #0f0f16;
            --panel-2: #16161f;
            --line: rgba(255,255,255,.09);
            --txt: #ffffff;
            --txt-2: #a8a8bb;
            --txt-3: #62627a;
            --accent: #a855f7;
            --accent-2: #ec4899;
            --ok: #1ed760;
            --warn: #f59e0b;
            --danger: #f43f5e;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        body {
            background: var(--bg);
            color: var(--txt);
            font-family: 'Figtree', system-ui, sans-serif;
            overflow-x: hidden;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .auth {
            display: grid;
            grid-template-columns: .95fr 1.05fr;
            min-height: 100vh;
        }

        /* ---------- LEFT PANEL (FORM) ---------- */
        .panel {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 44px 40px;
            background: var(--bg);
        }

        .card {
            width: 100%;
            max-width: 430px;
            animation: fadeUp .7s cubic-bezier(.22,1,.36,1) both;
        }

        .card-kicker {
            font-size: .74rem;
            font-weight: 800;
            letter-spacing: 1.7px;
            text-transform: uppercase;
            color: var(--accent);
            margin-bottom: 10px;
        }

        .card-title {
            font-size: 2.05rem;
            font-weight: 800;
            letter-spacing: -1.2px;
        }

        .card-sub {
            margin-top: 8px;
            font-size: .94rem;
            color: var(--txt-2);
        }

        .alert {
            display: flex;
            align-items: flex-start;
            gap: 11px;
            margin-top: 22px;
            padding: 13px 15px;
            border-radius: 12px;
            background: rgba(244,63,94,.1);
            border: 1px solid rgba(244,63,94,.32);
            color: #ffd9e1;
            font-size: .88rem;
            line-height: 1.45;
            animation: shake .45s ease;
        }

            .alert i {
                color: var(--danger);
                font-size: 1.1rem;
                flex-shrink: 0;
            }

        form {
            margin-top: 24px;
        }

        .duo {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .field {
            margin-bottom: 15px;
        }

            .field label {
                display: block;
                font-size: .8rem;
                font-weight: 700;
                color: var(--txt-2);
                margin-bottom: 7px;
            }

        .wrap {
            position: relative;
        }

            .wrap > i.lead {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--txt-3);
                font-size: 1.05rem;
                transition: color .22s;
            }

        .inp {
            width: 100%;
            height: 50px;
            border-radius: 13px;
            border: 1px solid var(--line);
            background: var(--panel-2);
            color: var(--txt);
            padding: 0 46px;
            font-family: inherit;
            font-size: .95rem;
            outline: none;
            transition: border-color .22s, box-shadow .22s, background .22s;
        }

            .inp::placeholder {
                color: var(--txt-3);
            }

            .inp:focus {
                border-color: rgba(168,85,247,.75);
                box-shadow: 0 0 0 4px rgba(168,85,247,.14);
                background: #191922;
            }

        .wrap:focus-within > i.lead {
            color: var(--accent);
        }

        .peek {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            width: 34px;
            height: 34px;
            border: none;
            border-radius: 9px;
            background: transparent;
            color: var(--txt-3);
            cursor: pointer;
            font-size: 1.05rem;
        }

            .peek:hover {
                color: var(--txt);
                background: rgba(255,255,255,.06);
            }

        .meter {
            display: flex;
            gap: 5px;
            margin-top: 9px;
        }

            .meter i {
                flex: 1;
                height: 4px;
                border-radius: 4px;
                background: var(--panel-2);
                transition: background .25s;
            }

        .meter-txt {
            margin-top: 7px;
            font-size: .78rem;
            color: var(--txt-3);
        }

        .rules {
            display: flex;
            flex-wrap: wrap;
            gap: 6px 14px;
            margin-top: 9px;
            font-size: .77rem;
            color: var(--txt-3);
        }

            .rules span {
                display: flex;
                align-items: center;
                gap: 5px;
                transition: color .2s;
            }

                .rules span.ok {
                    color: var(--ok);
                }

                .rules span i {
                    font-size: .85rem;
                }

        .terms {
            display: flex;
            align-items: flex-start;
            gap: 9px;
            margin: 18px 0 20px;
            font-size: .85rem;
            color: var(--txt-2);
            line-height: 1.5;
            cursor: pointer;
        }

            .terms input {
                width: 17px;
                height: 17px;
                margin-top: 2px;
                accent-color: var(--accent);
                cursor: pointer;
                flex-shrink: 0;
            }

            .terms a {
                color: var(--accent);
            }

        .btn {
            width: 100%;
            height: 52px;
            border: none;
            border-radius: 13px;
            background: linear-gradient(120deg, var(--accent), var(--accent-2));
            color: #fff;
            font-family: inherit;
            font-size: 1rem;
            font-weight: 800;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            transition: transform .22s cubic-bezier(.34,1.56,.64,1), filter .22s;
        }

            .btn:hover {
                transform: translateY(-2px);
                filter: brightness(1.12);
            }

            .btn:active {
                transform: translateY(0) scale(.985);
            }

            .btn i {
                transition: transform .25s;
            }

            .btn:hover i {
                transform: translateX(4px);
            }

        .foot {
            margin-top: 22px;
            text-align: center;
            font-size: .92rem;
            color: var(--txt-2);
        }

            .foot a {
                color: var(--accent);
                font-weight: 700;
            }

                .foot a:hover {
                    text-decoration: underline;
                }

        /* ---------- RIGHT STAGE ---------- */
        .stage {
            position: relative;
            overflow: hidden;
            padding: 44px 52px;
            display: flex;
            flex-direction: column;
            background: var(--panel);
        }

        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            pointer-events: none;
        }

        .orb-a {
            width: 430px;
            height: 430px;
            top: -170px;
            right: -130px;
            background: rgba(236,72,153,.44);
            animation: floatOrb 21s ease-in-out infinite;
        }

        .orb-b {
            width: 350px;
            height: 350px;
            bottom: -140px;
            left: -100px;
            background: rgba(168,85,247,.42);
            animation: floatOrb 26s ease-in-out infinite reverse;
        }

        .stage > *:not(.orb) {
            position: relative;
            z-index: 1;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 11px;
            font-weight: 900;
            font-size: 1.32rem;
            letter-spacing: -.6px;
            justify-content: flex-end;
        }

        .brand-dot {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            display: grid;
            place-items: center;
            font-size: 1rem;
        }

        .stage-mid {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 40px 0;
        }

        .stage-title {
            font-size: clamp(2rem, 3.6vw, 3.1rem);
            font-weight: 900;
            letter-spacing: -1.9px;
            line-height: 1.06;
            max-width: 16ch;
            animation: fadeUp .8s .06s cubic-bezier(.22,1,.36,1) both;
        }

            .stage-title em {
                font-style: normal;
                background: linear-gradient(120deg, var(--accent-2), var(--accent));
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
            }

        .plans {
            margin-top: 34px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .plan {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 13px 16px;
            border-radius: 13px;
            background: rgba(255,255,255,.04);
            border: 1px solid var(--line);
            backdrop-filter: blur(16px);
            animation: fadeUp .7s cubic-bezier(.22,1,.36,1) both;
        }

            .plan:nth-child(1) {
                animation-delay: .12s;
            }

            .plan:nth-child(2) {
                animation-delay: .2s;
            }

            .plan:nth-child(3) {
                animation-delay: .28s;
            }

            .plan:nth-child(4) {
                animation-delay: .36s;
            }

            .plan.live {
                border-color: rgba(30,215,96,.42);
                background: rgba(30,215,96,.07);
            }

        .plan-ico {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            display: grid;
            place-items: center;
            font-size: .95rem;
            background: rgba(255,255,255,.07);
            flex-shrink: 0;
        }

        .plan.live .plan-ico {
            background: var(--ok);
            color: #000;
        }

        .plan-n {
            font-size: .93rem;
            font-weight: 700;
        }

        .plan-d {
            font-size: .78rem;
            color: var(--txt-3);
        }

        .plan-tag {
            margin-left: auto;
            font-size: .7rem;
            font-weight: 800;
            letter-spacing: .5px;
            text-transform: uppercase;
            padding: 4px 9px;
            border-radius: 50px;
            background: var(--ok);
            color: #000;
        }

        .stage-foot {
            font-size: .82rem;
            color: var(--txt-3);
            text-align: right;
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(24px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes floatOrb {
            0%, 100% {
                transform: translate(0,0) scale(1);
            }

            50% {
                transform: translate(-44px,32px) scale(1.15);
            }
        }

        @@keyframes shake {
            0%, 100% {
                transform: translateX(0);
            }

            20% {
                transform: translateX(-7px);
            }

            40% {
                transform: translateX(6px);
            }

            60% {
                transform: translateX(-4px);
            }

            80% {
                transform: translateX(2px);
            }
        }

        @@media (max-width: 940px) {
            .auth {
                grid-template-columns: 1fr;
            }

            .stage {
                display: none;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .01ms !important;
            }
        }
    </style>
</head>
<body>
    <div class="auth">

        <section class="panel">
            <div class="card">
                <div class="card-kicker">Ücretsiz başla</div>
                <h2 class="card-title">Hesap oluştur</h2>
                <p class="card-sub">Birkaç saniye sürer, kredi kartı gerekmez.</p>

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert" role="alert">
                        <i class="bi bi-exclamation-octagon-fill"></i>
                        <span>@ViewBag.ErrorMessage</span>
                    </div>
                }

                <form method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="duo">
                        <div class="field">
                            <label for="Name">Ad</label>
                            <div class="wrap">
                                <i class="bi bi-person lead"></i>
                                <input asp-for="Name" id="Name" name="Name" class="inp"
                                       type="text" placeholder="Adınız" autocomplete="given-name" />
                            </div>
                        </div>
                        <div class="field">
                            <label for="Surname">Soyad</label>
                            <div class="wrap">
                                <i class="bi bi-person lead"></i>
                                <input asp-for="Surname" id="Surname" name="Surname" class="inp"
                                       type="text" placeholder="Soyadınız" autocomplete="family-name" />
                            </div>
                        </div>
                    </div>

                    <div class="field">
                        <label for="Username">Kullanıcı adı</label>
                        <div class="wrap">
                            <i class="bi bi-at lead"></i>
                            <input asp-for="Username" id="Username" name="Username" class="inp"
                                   type="text" placeholder="Kullanıcı adınız" autocomplete="username" />
                        </div>
                    </div>

                    <div class="field">
                        <label for="Email">E-posta</label>
                        <div class="wrap">
                            <i class="bi bi-envelope lead"></i>
                            <input asp-for="Email" id="Email" name="Email" class="inp"
                                   type="email" placeholder="ornek@eposta.com" autocomplete="email" />
                        </div>
                    </div>

                    <div class="field">
                        <label for="Password">Şifre</label>
                        <div class="wrap">
                            <i class="bi bi-lock lead"></i>
                            <input asp-for="Password" id="Password" name="Password" class="inp"
                                   type="password" placeholder="••••••••" autocomplete="new-password" />
                            <button class="peek" type="button" id="peek" aria-label="Şifreyi göster">
                                <i class="bi bi-eye" id="peekIcon"></i>
                            </button>
                        </div>

                        <div class="meter">
                            <i id="m1"></i><i id="m2"></i><i id="m3"></i><i id="m4"></i>
                        </div>
                        <div class="meter-txt" id="meterTxt">Şifre gücü</div>

                        <div class="rules">
                            <span id="r-len"><i class="bi bi-circle"></i>6+ karakter</span>
                            <span id="r-up"><i class="bi bi-circle"></i>Büyük harf</span>
                            <span id="r-low"><i class="bi bi-circle"></i>Küçük harf</span>
                            <span id="r-num"><i class="bi bi-circle"></i>Rakam</span>
                            <span id="r-sym"><i class="bi bi-circle"></i>Özel karakter</span>
                        </div>
                    </div>

                    <label class="terms">
                        <input type="checkbox" name="terms" />
                        <span>Echoa <a href="#">kullanım koşulları</a> ve <a href="#">gizlilik politikasını</a> kabul ediyorum.</span>
                    </label>

                    <button class="btn" type="submit">
                        Hesabımı oluştur
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </form>

                <div class="foot">
                    Zaten hesabın var mı?
                    <a asp-controller="Login" asp-action="SignIn">Giriş yap</a>
                </div>
            </div>
        </section>

        <section class="stage">
            <div class="orb orb-a"></div>
            <div class="orb orb-b"></div>

            <div class="brand">
                Echoa
                <div class="brand-dot"><i class="bi bi-broadcast"></i></div>
            </div>

            <div class="stage-mid">
                <h1 class="stage-title">Her paket, <em>yeni bir katman</em> açar.</h1>

                <div class="plans">
                    <div class="plan live">
                        <div class="plan-ico"><i class="bi bi-play-fill"></i></div>
                        <div>
                            <div class="plan-n">Basic</div>
                            <div class="plan-d">Temel katalog, reklamsız</div>
                        </div>
                        <span class="plan-tag">Başlangıç</span>
                    </div>
                    <div class="plan">
                        <div class="plan-ico"><i class="bi bi-star"></i></div>
                        <div>
                            <div class="plan-n">Gold</div>
                            <div class="plan-d">Popüler parçalar dahil</div>
                        </div>
                    </div>
                    <div class="plan">
                        <div class="plan-ico"><i class="bi bi-gem"></i></div>
                        <div>
                            <div class="plan-n">Premium</div>
                            <div class="plan-d">Yüksek kalite, özel içerik</div>
                        </div>
                    </div>
                    <div class="plan">
                        <div class="plan-ico"><i class="bi bi-trophy"></i></div>
                        <div>
                            <div class="plan-n">Elit</div>
                            <div class="plan-d">Kütüphanenin tamamı</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="stage-foot">Yeni hesaplar Basic paketiyle başlar.</div>
        </section>

    </div>

    <script>
        var pw = document.getElementById('Password');
        var peek = document.getElementById('peek');
        var peekIcon = document.getElementById('peekIcon');

        peek.addEventListener('click', function () {
            var show = pw.type === 'password';
            pw.type = show ? 'text' : 'password';
            peekIcon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
            peek.setAttribute('aria-label', show ? 'Şifreyi gizle' : 'Şifreyi göster');
        });

        var bars = [document.getElementById('m1'), document.getElementById('m2'),
                    document.getElementById('m3'), document.getElementById('m4')];
        var meterTxt = document.getElementById('meterTxt');

        var rules = {
            'r-len': function (v) { return v.length >= 6; },
            'r-up': function (v) { return /[A-ZÇĞİÖŞÜ]/.test(v); },
            'r-low': function (v) { return /[a-zçğıöşü]/.test(v); },
            'r-num': function (v) { return /[0-9]/.test(v); },
            'r-sym': function (v) { return /[^A-Za-z0-9]/.test(v); }
        };

        var labels = ['Şifre gücü', 'Zayıf', 'Orta', 'İyi', 'Güçlü'];
        var colors = ['', '#f43f5e', '#f59e0b', '#22d3ee', '#1ed760'];

        pw.addEventListener('input', function () {
            var v = pw.value;
            var passed = 0;

            Object.keys(rules).forEach(function (id) {
                var ok = rules[id](v);
                var el = document.getElementById(id);
                el.classList.toggle('ok', ok);
                el.querySelector('i').className = ok ? 'bi bi-check-circle-fill' : 'bi bi-circle';
                if (ok) { passed++; }
            });

            var score = v.length === 0 ? 0 : Math.min(4, Math.max(1, passed - 1));

            bars.forEach(function (b, i) {
                b.style.background = i < score ? colors[score] : '#16161f';
            });

            meterTxt.textContent = labels[score];
            meterTxt.style.color = score === 0 ? '#62627a' : colors[score];
        });
    </script>
</body>
</html>
