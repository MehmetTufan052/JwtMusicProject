@model List<JwtMusicNight.WebUI.Dtos.ResultArtistDto>
@{
    Layout = null;
    ViewData["Title"] = "Takip Ettiklerim – Echoa";
    var userPkg = (string)ViewBag.PackageName;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <script src="/js/spa-router.js?v=20261028-playerbar"></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <style>
        :root {
            --bg: #000;
            --panel: #121212;
            --panel-2: #181818;
            --panel-3: #232323;
            --line: rgba(255,255,255,.09);
            --txt: #fff;
            --txt-2: #b3b3b3;
            --txt-3: #6a6a6a;
            --accent: #a855f7;
            --accent-2: #ec4899;
            --ok: #1ed760;
            --danger: #f43f5e;
            --player-h: 76px;
            --rail-w: 258px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { height: 100%; }

        body {
            background: var(--bg);
            color: var(--txt);
            font-family: 'Figtree', system-ui, sans-serif;
            overflow: hidden;
            width: 100%;
        }

        a { color: inherit; text-decoration: none; }

        .shell {
            display: grid;
            grid-template-columns: var(--rail-w) minmax(0, 1fr);
            grid-template-rows: 1fr var(--player-h);
            width: 100%;
            max-width: 100vw;
            height: 100dvh;
            gap: 10px;
            padding: 10px;
            overflow: hidden;
        }

        .rail { grid-row: 1; display: flex; flex-direction: column; gap: 10px; min-height: 0; }
        .rail-box { background: var(--panel); border-radius: 10px; padding: 18px 14px; }

        .brand {
            display: flex; align-items: center; gap: 10px;
            padding: 4px 8px 14px; font-weight: 800; font-size: 1.18rem; letter-spacing: -.5px;
        }

        .brand-dot {
            width: 26px; height: 26px; border-radius: 50%;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            display: grid; place-items: center; font-size: .85rem;
        }

        .nav-item {
            display: flex; align-items: center; gap: 15px; padding: 11px 12px; border-radius: 7px;
            color: var(--txt-2); font-weight: 600; font-size: .92rem; position: relative;
            transition: color .18s, background .18s;
        }

        .nav-item i { font-size: 1.22rem; }
        .nav-item:hover { color: var(--txt); }
        .nav-item.on { color: var(--txt); background: var(--panel-3); }

        .nav-item::before {
            content: ''; position: absolute; left: 0; top: 50%; width: 3px; height: 0; border-radius: 3px;
            background: linear-gradient(var(--accent), var(--accent-2));
            transform: translateY(-50%); transition: height .28s cubic-bezier(.22,1,.36,1);
        }

        .nav-item.on::before, .nav-item:hover::before { height: 62%; }

        .main {
            grid-row: 1; min-width: 0; min-height: 0; position: relative;
            background: var(--panel); border-radius: 10px; overflow-x: hidden; overflow-y: auto;
        }

        .topbar {
            position: sticky; top: 0; z-index: 20; display: flex; align-items: center; gap: 14px;
            padding: 16px 32px; background: rgba(18,18,18,.82); backdrop-filter: blur(18px); border-bottom: 1px solid transparent;
        }

        .topbar.stuck { border-bottom-color: var(--line); }

        .spacer { flex: 1; }

        .pkg-pill {
            display: flex; align-items: center; gap: 7px; height: 32px; padding: 0 14px; border-radius: 50px;
            background: linear-gradient(135deg, var(--accent), var(--accent-2)); font-size: .8rem; font-weight: 700;
        }

        .avatar-pill {
            width: 32px; height: 32px; border-radius: 50%; background: var(--panel-3);
            display: grid; place-items: center; font-size: .95rem; color: var(--txt-2);
            cursor: pointer;
        }

        .user-menu { position: relative; }
        .user-dropdown {
            position: absolute; top: calc(100% + 10px); right: 0; min-width: 180px;
            background: var(--panel-2); border: 1px solid var(--line); border-radius: 12px;
            padding: 8px; display: none; flex-direction: column; gap: 4px; z-index: 50;
            box-shadow: 0 16px 40px rgba(0,0,0,.4);
        }
        .user-dropdown.show { display: flex; }
        .user-dropdown-logout {
            display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-radius: 8px;
            font-size: .82rem; color: var(--txt); cursor: pointer;
        }
        .user-dropdown-logout:hover { background: var(--panel-3); color: var(--danger); }
        .user-dropdown-admin { display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-radius: 8px; font-size: .82rem; color: var(--txt); cursor: pointer; }
        .user-dropdown-admin:hover { background: var(--panel-3); color: var(--accent); }

        .hero { position: relative; overflow: hidden; padding: 38px 32px 42px; }

        .orb { position: absolute; border-radius: 50%; filter: blur(70px); pointer-events: none; z-index: 0; }
        .orb-a { width: 340px; height: 340px; top: -140px; left: -60px; background: rgba(168,85,247,.45); animation: floatOrb 17s ease-in-out infinite; }
        .orb-b { width: 280px; height: 280px; top: -60px; left: 46%; background: rgba(236,72,153,.3); animation: floatOrb 21s ease-in-out infinite reverse; }
        .hero > *:not(.orb) { position: relative; z-index: 1; }

        .hero-kicker { font-size: .76rem; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; color: var(--txt-2); margin-bottom: 10px; }
        .hero-title { font-size: clamp(2.4rem, 6vw, 4.2rem); font-weight: 800; letter-spacing: -2.5px; line-height: 1.02; }

        .hero-meta { margin-top: 14px; font-size: .9rem; color: var(--txt-2); display: flex; align-items: center; gap: 8px; }

        .hero-layout { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:36px; }
        .hero-copy { max-width:720px; }
        .hero-desc { max-width:610px; margin-top:16px; color:var(--txt-2); line-height:1.65; font-size:.96rem; }
        .hero-stats { display:flex; gap:10px; flex-wrap:wrap; margin-top:24px; }
        .stat-pill { display:flex; align-items:center; gap:9px; min-height:42px; padding:0 15px; border:1px solid var(--line); border-radius:12px; background:rgba(255,255,255,.055); font-size:.82rem; color:var(--txt-2); }
        .stat-pill i { color:#d8b4fe; font-size:1rem; }
        .stat-pill strong { color:var(--txt); }
        .hero-stack { position:relative; width:220px; height:150px; margin-right:14px; }
        .stack-art { position:absolute; width:118px; height:118px; border-radius:50%; overflow:hidden; border:4px solid var(--panel); background:linear-gradient(135deg,var(--accent),var(--accent-2)); box-shadow:0 18px 45px rgba(0,0,0,.45); }
        .stack-art img { width:100%; height:100%; object-fit:cover; }
        .stack-art:nth-child(1) { left:0; top:25px; z-index:1; }
        .stack-art:nth-child(2) { left:58px; top:0; z-index:3; }
        .stack-art:nth-child(3) { left:112px; top:30px; z-index:2; }

        .sec { width: 100%; min-width: 0; padding: 12px 32px 38px; overflow: hidden; }

        .section-head { display:flex; align-items:end; justify-content:space-between; gap:20px; margin-bottom:18px; }
        .section-title { font-size:1.35rem; font-weight:800; letter-spacing:-.4px; }
        .section-copy { margin-top:5px; color:var(--txt-3); font-size:.84rem; }
        .artist-search { width:min(300px,100%); height:42px; display:flex; align-items:center; gap:10px; padding:0 14px; border:1px solid var(--line); border-radius:12px; background:var(--panel-2); color:var(--txt-2); }
        .artist-search input { width:100%; border:0; outline:0; background:transparent; color:var(--txt); font:inherit; font-size:.86rem; }

        /* ---------- ARTIST GRID ---------- */
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 18px; }

        .card { display: block; min-width:0; background:linear-gradient(180deg,rgba(255,255,255,.045),rgba(255,255,255,.018)); border:1px solid var(--line); border-radius:16px; padding:14px; transition:transform .22s, background .22s, border-color .22s; position: relative; animation:fadeUp .5s both; }
        .card:hover { background:var(--panel-2); border-color:rgba(168,85,247,.35); transform:translateY(-5px); }

        .card-art { position: relative; width: 100%; aspect-ratio: 1; border-radius: 50%; overflow: hidden; margin-bottom: 14px; background: var(--panel-3); }
        .card-art img { width: 100%; height: 100%; object-fit: cover; display: block; }

        .circle-fallback {
            width: 100%; height: 100%; display: grid; place-items: center;
            font-size: 2.6rem; font-weight: 800; color: rgba(255,255,255,.92);
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
        }

        .card-name { display: flex; align-items: center; gap: 6px; font-size: .95rem; font-weight: 700; white-space: nowrap; overflow: hidden; }
        .card-name span { overflow: hidden; text-overflow: ellipsis; }
        .card-name .bi-patch-check-fill { color: #3d9df3; font-size: .82rem; flex-shrink: 0; }
        .card-sub { margin-top: 5px; font-size: .82rem; color: var(--txt-3); }
        .card-bio { margin-top:10px; min-height:38px; color:var(--txt-2); font-size:.78rem; line-height:1.45; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
        .card-foot { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-top:14px; padding-top:12px; border-top:1px solid var(--line); }
        .following { display:inline-flex; align-items:center; gap:6px; color:#f0abfc; font-size:.74rem; font-weight:700; }
        .profile-link { display:inline-flex; align-items:center; gap:5px; color:var(--txt); font-size:.75rem; font-weight:700; }
        .empty { border:1px dashed var(--line); border-radius:18px; background:rgba(255,255,255,.025); }
        .empty-cta { display:inline-flex; align-items:center; gap:8px; margin-top:16px; padding:11px 17px; border-radius:999px; background:linear-gradient(135deg,var(--accent),var(--accent-2)); color:#fff; font-weight:750; font-size:.84rem; }

        .empty { text-align: center; padding: 50px 20px; color: var(--txt-3); }
        .empty i { font-size: 2.3rem; display: block; margin-bottom: 12px; }

        /* ---------- PLAYER ---------- */
        .player {
            grid-column: 1 / -1; grid-row: 2; min-width: 0; overflow: hidden;
            display: flex; align-items: center; gap: 16px; padding: 0 16px;
        }
        .np { display: flex; align-items: center; gap: 12px; width: 260px; min-width: 0; }

        .np-art {
            width: 54px; height: 54px; border-radius: 6px;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            display: grid; place-items: center; font-size: 1.3rem; flex-shrink: 0; transition: transform .4s;
        }

        .np-art.spin { animation: spin 6s linear infinite; }

        .np-name { font-size: .88rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .np-sub { font-size: .76rem; color: var(--txt-3); display: flex; align-items: center; gap: 8px; }

        .eq { display: none; align-items: flex-end; gap: 2px; width: 20px; height: 15px; }
        .eq.on { display: flex; }
        .eq span { flex: 1; background: var(--ok); border-radius: 1px; animation: eqBar .85s ease-in-out infinite; }
        .eq span:nth-child(2) { animation-delay: .18s; }
        .eq span:nth-child(3) { animation-delay: .36s; }
        .eq span:nth-child(4) { animation-delay: .54s; }

        .pl-center { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 8px; }
        .pl-play {
            width: 36px; height: 36px; border-radius: 50%; background: var(--txt); color: #000;
            display: grid; place-items: center; font-size: 1.1rem; border: none; cursor: pointer;
            transition: transform .25s cubic-bezier(.34,1.56,.64,1);
        }
        .pl-play:hover { transform: scale(1.12); }

        ::-webkit-scrollbar { width: 11px; }
        ::-webkit-scrollbar-thumb { background: #4a4a4a; border-radius: 6px; border: 3px solid transparent; background-clip: content-box; }

        @@keyframes fadeUp { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: translateY(0); } }
        @@keyframes floatOrb { 0%, 100% { transform: translate(0,0) scale(1); } 50% { transform: translate(38px,-26px) scale(1.14); } }
        @@keyframes spin { to { transform: rotate(360deg); } }
        @@keyframes eqBar { 0%, 100% { height: 22%; } 50% { height: 100%; } }

        @@media (max-width: 1000px) {
            .shell { grid-template-columns: minmax(0, 1fr); }
            .rail { display: none; }
        }
        @@media (max-width: 760px) {
            .hero, .sec { padding-left:18px; padding-right:18px; }
            .hero-layout { grid-template-columns:1fr; }
            .hero-stack { display:none; }
            .section-head { align-items:stretch; flex-direction:column; }
            .artist-search { width:100%; }
            .grid { grid-template-columns:repeat(auto-fill,minmax(155px,1fr)); gap:12px; }
        }
    </style>
</head>
<body>
    <div class="shell">

        <aside class="rail">
            <div class="rail-box">
                <div class="brand">
                    <div class="brand-dot"><i class="bi bi-broadcast"></i></div>
                    Echoa
                </div>
                <a class="nav-item" href="/Home/Index"><i class="bi bi-house-door"></i>Ana sayfa</a>
                <a class="nav-item" href="/Artist/ArtistListV2"><i class="bi bi-person-badge"></i>Sanatçılar</a>
                <a class="nav-item" href="/Genre/GenreList"><i class="bi bi-collection"></i>Türler</a>
                <a class="nav-item" href="/Song/Charts"><i class="bi bi-music-note-list"></i>Şarkılar</a>
                <a class="nav-item" href="/Song/History"><i class="bi bi-clock-history"></i>Geçmiş</a>
                <a class="nav-item on" href="/Artist/Followed"><i class="bi bi-person-heart"></i>Takip Ettiklerim</a>
                <a class="nav-item" href="/Song/Favorites"><i class="bi bi-heart"></i>Beğendiklerim</a>
                <a class="nav-item" href="/Playlist/Index"><i class="bi bi-collection-play"></i>Çalma Listelerim</a>
            </div>
        </aside>

        <main class="main" id="main">

            <div class="topbar" id="topbar">
                <div class="spacer"></div>
                <a class="pkg-pill" href="/Package/Index" title="Paketleri incele"><i class="bi bi-gem"></i>@userPkg</a>
                <div class="user-menu" id="userMenu">
                    <div class="avatar-pill" id="avatarBtn"><i class="bi bi-person-fill"></i></div>
                    <div class="user-dropdown" id="userDropdown">
                        @if ((bool)(ViewBag.IsAdmin ?? false))
                        {
                            <a class="user-dropdown-admin" href="/Admin/Index"><i class="bi bi-gear"></i>Admin Paneli</a>
                        }
                        <a class="user-dropdown-logout" data-no-route href="/Login/Logout"><i class="bi bi-box-arrow-right"></i>Çıkış yap</a>
                    </div>
                </div>
            </div>

            <section class="hero">
                <div class="orb orb-a"></div>
                <div class="orb orb-b"></div>
                <div class="hero-layout">
                    <div class="hero-copy">
                        <div class="hero-kicker">Sana özel sanatçı alanı</div>
                        <h1 class="hero-title">Takip Ettiklerim</h1>
                        <p class="hero-desc">Sevdiğin sanatçıları tek bir yerde tut, profillerine hızlıca ulaş ve yeni şarkılarını keşfetmeye kaldığın yerden devam et.</p>
                        <div class="hero-stats">
                            <div class="stat-pill"><i class="bi bi-person-heart"></i><span><strong>@Model.Count</strong> sanatçı takip ediliyor</span></div>
                            <div class="stat-pill"><i class="bi bi-patch-check-fill"></i><span><strong>@Model.Count(a => a.IsVerified)</strong> onaylı profil</span></div>
                            <div class="stat-pill"><i class="bi bi-globe2"></i><span><strong>@Model.Select(a => a.Country).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct().Count()</strong> farklı ülke</span></div>
                        </div>
                    </div>
                    @if (Model.Count > 0)
                    {
                        <div class="hero-stack" aria-hidden="true">
                            @foreach (var artist in Model.Take(3))
                            {
                                <div class="stack-art">
                                    @if (!string.IsNullOrWhiteSpace(artist.ArtistImageUrl)) { <img src="@artist.ArtistImageUrl" alt="" /> }
                                    else { <div class="circle-fallback">@artist.ArtistName.Substring(0, 1)</div> }
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>

            <section class="sec">
                <div class="section-head">
                    <div><h2 class="section-title">Sanatçı koleksiyonun</h2><p class="section-copy">Takip ettiğin profilleri görüntüle ve keşfetmeye devam et.</p></div>
                    @if (Model.Count > 0)
                    {
                        <label class="artist-search"><i class="bi bi-search"></i><input id="artistSearch" type="search" placeholder="Sanatçı ara..." autocomplete="off" /></label>
                    }
                </div>
                @if (Model.Count == 0)
                {
                    <div class="empty"><i class="bi bi-heart"></i><strong>Henüz hiçbir sanatçıyı takip etmiyorsun.</strong><div>Sanatçıları keşfet ve sevdiklerini koleksiyonuna ekle.</div><a class="empty-cta" href="/Artist/ArtistListV2"><i class="bi bi-compass"></i>Sanatçıları keşfet</a></div>
                }
                else
                {
                    <div class="grid" id="artistGrid">
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var a = Model[i];
                            <a class="card" href="/Artist/ArtistDetail/@a.ArtistId" data-search="@($"{a.ArtistName} {a.Country}".ToLowerInvariant())" style="animation-delay:@(i * 55)ms">
                                <div class="card-art">
                                    @if (!string.IsNullOrWhiteSpace(a.ArtistImageUrl))
                                    {
                                        <img src="@a.ArtistImageUrl" alt="@a.ArtistName" />
                                    }
                                    else
                                    {
                                        <div class="circle-fallback">@a.ArtistName.Substring(0, 1)</div>
                                    }
                                </div>
                                <div class="card-name">
                                    <span>@a.ArtistName</span>
                                    @if (a.IsVerified)
                                    {
                                        <i class="bi bi-patch-check-fill" title="Onaylı sanatçı"></i>
                                    }
                                </div>
                                <div class="card-sub">@a.Country</div>
                                <div class="card-bio">@(string.IsNullOrWhiteSpace(a.Bio) ? "Sanatçının profilini ve yayınlanan şarkılarını keşfet." : a.Bio)</div>
                                <div class="card-foot"><span class="following"><i class="bi bi-check2-circle"></i>Takip ediliyor</span><span class="profile-link">Profile git <i class="bi bi-arrow-right"></i></span></div>
                            </a>
                        }
                    </div>
                    <div class="empty" id="searchEmpty" style="display:none"><i class="bi bi-search"></i>Aramana uygun sanatçı bulunamadı.</div>
                }
            </section>

        </main>

        <div class="player">
            <div class="np">
                <div class="np-art" id="npArt"><i class="bi bi-music-note-beamed"></i></div>
                <div style="min-width:0">
                    <div class="np-name" id="npName">Bir şarkı seç</div>
                    <div class="np-sub">
                        <span id="npSub">Çalan bir şey yok</span>
                        <span class="eq" id="eq"><span></span><span></span><span></span><span></span></span>
                    </div>
                </div>
            </div>
            <div class="pl-center">
                <button class="pl-play" id="plPlay" aria-label="Çal"><i class="bi bi-play-fill" id="plIcon"></i></button>
            </div>
        </div>

    </div>

    <audio id="audio"></audio>

    <script>
        var main = document.getElementById('main');
        var topbar = document.getElementById('topbar');
        main.addEventListener('scroll', function () {
            topbar.classList.toggle('stuck', main.scrollTop > 8);
        });

        var avatarBtn = document.getElementById('avatarBtn');
        var userDropdown = document.getElementById('userDropdown');
        if (avatarBtn && userDropdown) {
            avatarBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                userDropdown.classList.toggle('show');
            });
            document.addEventListener('click', function () { userDropdown.classList.remove('show'); });
        }

        var artistSearch = document.getElementById('artistSearch');
        if (artistSearch) {
            artistSearch.addEventListener('input', function () {
                var query = this.value.trim().toLocaleLowerCase('tr-TR');
                var visible = 0;
                document.querySelectorAll('#artistGrid .card').forEach(function (card) {
                    var show = !query || card.dataset.search.toLocaleLowerCase('tr-TR').includes(query);
                    card.style.display = show ? '' : 'none';
                    if (show) { visible++; }
                });
                document.getElementById('searchEmpty').style.display = visible ? 'none' : 'block';
            });
        }

        var audio = document.getElementById('audio');
        var eq = document.getElementById('eq');
        var npArt = document.getElementById('npArt');
        var plPlay = document.getElementById('plPlay');
        var plIcon = document.getElementById('plIcon');

        function setPlaying(on) {
            eq.classList.toggle('on', on);
            npArt.classList.toggle('spin', on);
            plIcon.className = on ? 'bi bi-pause-fill' : 'bi bi-play-fill';
        }

        audio.addEventListener('play', function () { setPlaying(true); });
        audio.addEventListener('pause', function () { setPlaying(false); });

        plPlay.addEventListener('click', function () {
            if (!audio.src) { return; }
            if (audio.paused) { audio.play().catch(function () { }); } else { audio.pause(); }
        });

        (function () {
            var STORAGE_KEY = 'echoaNowPlaying';
            var audioEl = document.getElementById('audio');
            if (!audioEl) return;

            var saved = sessionStorage.getItem(STORAGE_KEY);
            if (!audioEl.src && saved) {
                try {
                    var state = JSON.parse(saved);
                    if (state.src) {
                        audioEl.src = state.src;
                        audioEl.currentTime = state.time || 0;
                        if (state.playing) {
                            audioEl.play().catch(function () { });
                        }
                        var npNameEl = document.getElementById('npName');
                        var npSubEl = document.getElementById('npSub');
                        if (npNameEl && state.name) { npNameEl.textContent = state.name; }
                        if (npSubEl && state.artist) { npSubEl.textContent = state.artist; }
                    }
                } catch (e) { }
            }

            window.addEventListener('pagehide', function () {
                if (!audioEl.src) return;
                sessionStorage.setItem(STORAGE_KEY, JSON.stringify({
                    src: audioEl.src,
                    time: audioEl.currentTime,
                    playing: !audioEl.paused,
                    name: (document.getElementById('npName') || {}).textContent,
                    artist: (document.getElementById('npSub') || {}).textContent
                }));
            });
        })();
    </script>
</body>
