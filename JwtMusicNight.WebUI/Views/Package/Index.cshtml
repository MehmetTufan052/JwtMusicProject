@{
    Layout = null;
    ViewData["Title"] = "Paketini Yükselt – Echoa";
    var currentPackage = (string)(ViewBag.PackageName ?? "Free");
    bool IsCurrent(string packageName) => string.Equals(currentPackage, packageName, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <script src="/js/spa-router.js"></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <style>
        :root{--bg:#000;--panel:#111114;--panel2:#18181d;--panel3:#23232a;--line:rgba(255,255,255,.09);--text:#fff;--muted:#aaa9b7;--dim:#71717f;--purple:#a855f7;--pink:#ec4899;--green:#1ed760;--rail:258px}
        *{box-sizing:border-box;margin:0;padding:0}html,body{min-height:100%}body{background:radial-gradient(circle at 50% 0,rgba(168,85,247,.11),transparent 34%),var(--bg);color:var(--text);font-family:Figtree,system-ui,sans-serif}a{color:inherit;text-decoration:none}button{font:inherit}
        .shell{width:min(1460px,100%);min-height:100vh;margin:0 auto;padding:18px}.rail{display:flex;flex-direction:column;gap:10px;position:sticky;top:10px;height:calc(100vh - 20px)}
        .rail-box,.rail-note{background:var(--panel);border:1px solid rgba(255,255,255,.045);border-radius:14px}.rail-box{padding:18px 14px}.brand{display:flex;align-items:center;gap:10px;padding:3px 10px 20px;font-size:1.18rem;font-weight:900}.brand-dot{width:27px;height:27px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,var(--purple),var(--pink))}
        .nav-item{display:flex;align-items:center;gap:15px;min-height:45px;padding:11px 12px;margin-bottom:3px;border-radius:9px;color:var(--muted);font-weight:600;font-size:.94rem;position:relative;transition:.18s}.nav-item i{font-size:1.18rem}.nav-item:hover,.nav-item.on{color:#fff;background:var(--panel3)}.nav-item.on:before{content:"";position:absolute;left:0;width:3px;height:62%;border-radius:3px;background:linear-gradient(var(--purple),var(--pink))}
        .rail-note{flex:1;padding:24px;display:flex;flex-direction:column;justify-content:flex-end;background:radial-gradient(circle at 80% 15%,rgba(168,85,247,.19),transparent 42%),var(--panel)}.rail-note i{font-size:1.7rem;color:#d8b4fe}.rail-note h3{margin-top:14px;font-size:1.05rem}.rail-note p{margin-top:8px;color:var(--muted);font-size:.82rem;line-height:1.55}
        .main{width:100%;min-height:calc(100vh - 36px);border:1px solid rgba(255,255,255,.055);border-radius:20px;overflow:hidden;box-shadow:0 28px 80px rgba(0,0,0,.38);background:radial-gradient(circle at 50% -15%,rgba(168,85,247,.24),transparent 34%),var(--panel)}.topbar{height:70px;padding:0 34px;display:flex;align-items:center;border-bottom:1px solid var(--line);background:rgba(17,17,20,.78);backdrop-filter:blur(18px)}.back{display:flex;align-items:center;gap:8px;color:var(--muted);font-weight:650}.back:hover{color:#fff}.spacer{flex:1}.current-pill{padding:9px 14px;border:1px solid rgba(255,255,255,.06);border-radius:99px;background:var(--panel3);font-size:.82rem;font-weight:700}.current-pill i{margin-right:7px;color:#d8b4fe}
        .hero{text-align:center;padding:52px 30px 38px}.eyebrow{display:inline-flex;align-items:center;gap:8px;padding:8px 13px;border:1px solid rgba(216,180,254,.2);border-radius:99px;background:rgba(168,85,247,.09);color:#e9d5ff;font-size:.77rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase}.hero h1{max-width:720px;margin:18px auto 0;font-size:clamp(2.35rem,4.2vw,4rem);line-height:1.02;letter-spacing:-.055em}.hero h1 span{background:linear-gradient(100deg,#c084fc,#f472b6);-webkit-background-clip:text;color:transparent}.hero p{max-width:620px;margin:16px auto 0;color:var(--muted);font-size:.98rem;line-height:1.65}
        .plans{width:min(1180px,calc(100% - 64px));margin:0 auto;padding:0 0 54px;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.plan{position:relative;display:flex;flex-direction:column;min-height:430px;padding:23px;border:1px solid var(--line);border-radius:18px;background:linear-gradient(155deg,rgba(255,255,255,.045),rgba(255,255,255,.015));transition:.25s}.plan:hover{transform:translateY(-6px);border-color:rgba(255,255,255,.2)}.plan.featured{border-color:rgba(192,132,252,.52);box-shadow:0 22px 65px rgba(126,34,206,.18);background:linear-gradient(155deg,rgba(168,85,247,.15),rgba(236,72,153,.045))}.popular{position:absolute;top:-13px;left:50%;transform:translateX(-50%);padding:6px 12px;border-radius:99px;background:linear-gradient(135deg,var(--purple),var(--pink));font-size:.71rem;font-weight:850;white-space:nowrap}.plan-icon{width:44px;height:44px;border-radius:13px;display:grid;place-items:center;background:var(--panel3);font-size:1.15rem}.plan.featured .plan-icon{background:linear-gradient(135deg,var(--purple),var(--pink))}.plan h2{margin-top:18px;font-size:1.35rem}.plan-copy{margin-top:7px;color:var(--dim);font-size:.82rem;line-height:1.45}.price{margin:23px 0 21px;font-size:1.8rem;font-weight:900;letter-spacing:-.04em}.price small{font-size:.77rem;font-weight:600;color:var(--muted);letter-spacing:0}.features{list-style:none;display:grid;gap:12px;margin-bottom:25px}.features li{display:flex;gap:9px;color:#d4d4dc;font-size:.84rem;line-height:1.35}.features i{color:#c084fc}.plan-action{margin-top:auto;width:100%;min-height:44px;border:0;border-radius:10px;background:#fff;color:#09090b;font-weight:800;cursor:pointer}.plan-action:hover{filter:brightness(.9)}.plan-action.current{background:var(--panel3);color:var(--muted);cursor:default}.plan-action.elite{color:#fff;background:linear-gradient(135deg,var(--purple),var(--pink))}
        .fine-print{text-align:center;padding:0 24px 45px;color:var(--dim);font-size:.78rem}.toast{position:fixed;right:26px;bottom:26px;max-width:360px;padding:16px 18px;border:1px solid rgba(192,132,252,.3);border-radius:13px;background:#202027;box-shadow:0 18px 50px rgba(0,0,0,.45);display:flex;gap:12px;align-items:flex-start;opacity:0;transform:translateY(18px);pointer-events:none;transition:.25s}.toast.show{opacity:1;transform:none}.toast i{color:#c084fc}.toast strong{display:block;font-size:.9rem}.toast span{display:block;margin-top:4px;color:var(--muted);font-size:.78rem;line-height:1.4}
        @@media(max-width:1080px){.plans{grid-template-columns:repeat(2,minmax(0,1fr));max-width:720px}.plan{min-height:400px}}
        @@media(max-width:900px){.shell{display:block;padding:0}.rail{display:none}.main{min-height:100vh;border-radius:0}.plans{padding-inline:20px}.topbar{padding-inline:20px}}
        @@media(max-width:620px){.hero{padding:46px 20px 34px}.plans{grid-template-columns:1fr}.plan{min-height:0}.current-pill{display:none}}
    </style>
</head>
<body>
<div class="shell">
    <main class="main">
        <header class="topbar"><a class="back" href="/Home/Index"><i class="bi bi-chevron-left"></i>Geri dön</a><span class="spacer"></span><span class="current-pill"><i class="bi bi-gem"></i>Mevcut: @currentPackage</span></header>
        <section class="hero"><span class="eyebrow"><i class="bi bi-stars"></i>Echoa üyelikleri</span><h1>Ritmini bir üst <span>seviyeye taşı.</span></h1><p>Dinleme alışkanlığına uygun paketi keşfet. Bu ekran yalnızca paket avantajlarını karşılaştırmak ve yükseltme seçeneklerini tanıtmak içindir.</p></section>
        <section class="plans">
            <article class="plan"><span class="plan-icon"><i class="bi bi-music-note"></i></span><h2>Free</h2><p class="plan-copy">Müziği keşfetmeye başlamak için.</p><div class="price">Ücretsiz</div><ul class="features"><li><i class="bi bi-check2"></i>Reklam destekli dinleme</li><li><i class="bi bi-check2"></i>Standart ses kalitesi</li><li><i class="bi bi-check2"></i>Temel müzik keşfi</li></ul><button class="plan-action @(IsCurrent("Free") ? "current" : "")" data-package="Free" @(IsCurrent("Free") ? "disabled" : "")>@(IsCurrent("Free") ? "Mevcut paket" : "Paketi incele")</button></article>
            <article class="plan"><span class="plan-icon"><i class="bi bi-play-circle"></i></span><h2>Basic</h2><p class="plan-copy">Kesintisiz ve kişisel bir deneyim.</p><div class="price">₺59,99 <small>/ ay</small></div><ul class="features"><li><i class="bi bi-check2"></i>Reklamsız dinleme</li><li><i class="bi bi-check2"></i>Çalma listesi oluşturma</li><li><i class="bi bi-check2"></i>Dinleme geçmişi</li></ul><button class="plan-action @(IsCurrent("Basic") ? "current" : "")" data-package="Basic" @(IsCurrent("Basic") ? "disabled" : "")>@(IsCurrent("Basic") ? "Mevcut paket" : "Yükseltme seçeneği")</button></article>
            <article class="plan featured"><span class="popular">EN ÇOK TERCİH EDİLEN</span><span class="plan-icon"><i class="bi bi-lightning-charge-fill"></i></span><h2>Gold</h2><p class="plan-copy">Müziği daha güçlü duymak isteyenlere.</p><div class="price">₺99,99 <small>/ ay</small></div><ul class="features"><li><i class="bi bi-check2"></i>Yüksek kalite ses</li><li><i class="bi bi-check2"></i>Çevrimdışı dinleme</li><li><i class="bi bi-check2"></i>Gelişmiş öneriler</li><li><i class="bi bi-check2"></i>Tüm Basic avantajları</li></ul><button class="plan-action @(IsCurrent("Gold") ? "current" : "")" data-package="Gold" @(IsCurrent("Gold") ? "disabled" : "")>@(IsCurrent("Gold") ? "Mevcut paket" : "Gold'a yükselt")</button></article>
            <article class="plan"><span class="plan-icon"><i class="bi bi-gem"></i></span><h2>Elite</h2><p class="plan-copy">Echoa deneyiminin tamamına eriş.</p><div class="price">₺149,99 <small>/ ay</small></div><ul class="features"><li><i class="bi bi-check2"></i>Tüm özelliklere erişim</li><li><i class="bi bi-check2"></i>Akıllı kişisel öneriler</li><li><i class="bi bi-check2"></i>Öncelikli yeni içerikler</li><li><i class="bi bi-check2"></i>En yüksek ses kalitesi</li></ul><button class="plan-action elite @(IsCurrent("Elite") ? "current" : "")" data-package="Elite" @(IsCurrent("Elite") ? "disabled" : "")>@(IsCurrent("Elite") ? "Mevcut paket" : "Elite'a yükselt")</button></article>
        </section>
        <p class="fine-print"><i class="bi bi-info-circle"></i> Fiyatlar aylık ve proje sunumu için kurgusaldır; hesabında otomatik paket veya ödeme değişikliği yapılmaz.</p>
    </main>
</div>
<div class="toast" id="toast"><i class="bi bi-stars"></i><div><strong id="toastTitle"></strong><span>Gerçek paket değiştirme işlemi henüz aktif değil. Paket avantajlarını karşılaştırmaya devam edebilirsin.</span></div></div>
<script>
document.querySelectorAll('.plan-action:not([disabled])').forEach(function(button){button.addEventListener('click',function(){var toast=document.getElementById('toast');document.getElementById('toastTitle').textContent=button.dataset.package+' yükseltme seçeneği';toast.classList.add('show');clearTimeout(window.packageToastTimer);window.packageToastTimer=setTimeout(function(){toast.classList.remove('show')},4200)})});
</script>
</body>
</html>
