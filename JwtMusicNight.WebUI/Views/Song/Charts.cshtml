@model List<JwtMusicNight.WebUI.Dtos.ResultSongDto>
@{
    Layout = null;
    ViewData["Title"] = "Top Charts – Echoa";
    var ranked = Model.OrderByDescending(s => s.ListenCount).ToList();
    var userLevel = (int)ViewBag.PackageLevel;
    var userPkg = (string)ViewBag.PackageName;
    var genres = Model.Select(s => s.GenreName).Where(g => g != null).Distinct().OrderBy(g => g).ToList();
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <style>
        :root {
            --bg: #000;
            --panel: #121212;
            --panel-2: #181818;
            --panel-3: #232323;
            --line: rgba(255,255,255,.09);
            --txt: #fff;
            --txt-2: #b3b3b3;
            --txt-3: #6a6a6a;
            --accent: #a855f7;
            --accent-2: #ec4899;
            --ok: #1ed760;
            --danger: #f43f5e;
            --player-h: 76px;
            --rail-w: 232px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { height: 100%; }

        body {
            background: var(--bg);
            color: var(--txt);
            font-family: 'Figtree', system-ui, sans-serif;
            overflow: hidden;
            width: 100%;
        }

        a { color: inherit; text-decoration: none; }

        .shell {
            display: grid;
            grid-template-columns: var(--rail-w) minmax(0, 1fr);
            grid-template-rows: 1fr var(--player-h);
            width: 100%;
            max-width: 100vw;
            height: 100dvh;
            gap: 8px;
            padding: 8px;
            overflow: hidden;
        }

        .rail { grid-row: 1; display: flex; flex-direction: column; gap: 8px; min-height: 0; }
        .rail-box { background: var(--panel); border-radius: 10px; padding: 16px 12px; }

        .brand {
            display: flex; align-items: center; gap: 10px;
            padding: 4px 8px 14px; font-weight: 800; font-size: 1.18rem; letter-spacing: -.5px;
        }

        .brand-dot {
            width: 26px; height: 26px; border-radius: 50%;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            display: grid; place-items: center; font-size: .85rem;
        }

        .nav-item {
            display: flex; align-items: center; gap: 14px; padding: 9px 10px; border-radius: 6px;
            color: var(--txt-2); font-weight: 600; font-size: .92rem; position: relative;
            transition: color .18s, background .18s;
        }

        .nav-item i { font-size: 1.22rem; }
        .nav-item:hover { color: var(--txt); }
        .nav-item.on { color: var(--txt); background: var(--panel-3); }

        .nav-item::before {
            content: ''; position: absolute; left: 0; top: 50%; width: 3px; height: 0; border-radius: 3px;
            background: linear-gradient(var(--accent), var(--accent-2));
            transform: translateY(-50%); transition: height .28s cubic-bezier(.22,1,.36,1);
        }

        .nav-item.on::before, .nav-item:hover::before { height: 62%; }

        .rail-scroll { background: var(--panel); border-radius: 10px; padding: 14px 12px; flex: 1; min-height: 0; overflow-y: auto; }

        .rail-head {
            display: flex; align-items: center; justify-content: space-between;
            color: var(--txt-2); font-weight: 700; font-size: .86rem; padding: 0 8px 12px;
        }

        .lib-row {
            display: flex; align-items: center; gap: 11px; padding: 7px 8px; border-radius: 6px;
            transition: background .18s, transform .22s;
        }

        .lib-row:hover { background: var(--panel-2); transform: translateX(4px); }

        .lib-num {
            width: 20px; text-align: center; font-size: .82rem; font-weight: 800; color: var(--txt-3); flex-shrink: 0;
        }

        .lib-thumb {
            width: 38px; height: 38px; border-radius: 6px; flex-shrink: 0; display: grid; place-items: center;
            font-size: .9rem; font-weight: 800; background: linear-gradient(135deg, var(--accent), var(--accent-2));
        }

        .lib-name { font-size: .86rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .lib-sub { font-size: .74rem; color: var(--txt-3); }

        .main {
            grid-row: 1; min-width: 0; min-height: 0; position: relative;
            background: var(--panel); border-radius: 10px; overflow-x: hidden; overflow-y: auto;
        }

        .topbar {
            position: sticky; top: 0; z-index: 20; display: flex; align-items: center; gap: 14px;
            padding: 14px 24px; background: rgba(18,18,18,.82); backdrop-filter: blur(18px); border-bottom: 1px solid transparent;
        }

        .topbar.stuck { border-bottom-color: var(--line); }

        .circle-btn {
            width: 32px; height: 32px; border-radius: 50%; border: none; background: rgba(0,0,0,.55);
            color: var(--txt-2); display: grid; place-items: center; cursor: pointer; flex-shrink: 0;
        }

        .circle-btn:hover { color: var(--txt); }

        .search { position: relative; flex: 1 1 260px; min-width: 0; max-width: 380px; }
        .search i { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); color: var(--txt-3); font-size: 1rem; }

        .search input {
            width: 100%; height: 38px; border-radius: 50px; border: 1px solid var(--line);
            background: var(--panel-2); color: var(--txt); padding: 0 16px 0 38px;
            font-family: inherit; font-size: .89rem; outline: none;
        }

        .search input::placeholder { color: var(--txt-3); }
        .search input:focus { border-color: rgba(255,255,255,.28); }

        .spacer { flex: 1; }

        .pkg-pill {
            display: flex; align-items: center; gap: 7px; height: 32px; padding: 0 14px; border-radius: 50px;
            background: linear-gradient(135deg, var(--accent), var(--accent-2)); font-size: .8rem; font-weight: 700;
        }

        .avatar-pill {
            width: 32px; height: 32px; border-radius: 50%; background: var(--panel-3);
            display: grid; place-items: center; font-size: .95rem; color: var(--txt-2);
        }

        .hero { position: relative; overflow: hidden; padding: 26px 24px 30px; }

        .orb { position: absolute; border-radius: 50%; filter: blur(70px); pointer-events: none; z-index: 0; }
        .orb-a { width: 340px; height: 340px; top: -140px; left: -60px; background: rgba(168,85,247,.45); animation: floatOrb 17s ease-in-out infinite; }
        .orb-b { width: 280px; height: 280px; top: -60px; left: 46%; background: rgba(236,72,153,.3); animation: floatOrb 21s ease-in-out infinite reverse; }
        .hero > *:not(.orb) { position: relative; z-index: 1; }

        .hero-kicker { font-size: .76rem; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; color: var(--txt-2); margin-bottom: 10px; }
        .hero-title { font-size: clamp(2.4rem, 6vw, 4.2rem); font-weight: 800; letter-spacing: -2.5px; line-height: 1.02; }

        .hero-meta { margin-top: 14px; font-size: .9rem; color: var(--txt-2); display: flex; align-items: center; gap: 8px; }
        .dot-sep { width: 4px; height: 4px; border-radius: 50%; background: var(--txt-3); }

        .sec { width: 100%; min-width: 0; padding: 6px 24px 30px; overflow: hidden; }
        .sec-head { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 18px; }
        .sec-title { font-size: 1.45rem; font-weight: 800; letter-spacing: -.7px; }

        .sec-link {
            border: 0; background: transparent; color: var(--txt-2); font-family: inherit;
            font-size: .8rem; font-weight: 700; cursor: pointer; transition: color .18s;
        }

        .sec-link:hover { color: var(--txt); }

        /* ---------- FEATURED CARDS ---------- */
        .featured-grid {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px;
            width: 100%; min-width: 0;
            margin-bottom: 34px;
        }

        .song-card {
            min-width: 0; padding: 12px; border: 1px solid transparent; border-radius: 12px;
            background: linear-gradient(180deg, rgba(255,255,255,.055), rgba(255,255,255,.025));
            cursor: pointer; transition: transform .24s cubic-bezier(.22,1,.36,1), background .2s, border-color .2s;
            animation: fadeUp .55s cubic-bezier(.22,1,.36,1) both;
        }

        .song-card:hover {
            transform: translateY(-6px); background: var(--panel-3); border-color: var(--line);
        }

        .song-card.locked { opacity: .64; }
        .song-card.locked:hover { opacity: .82; }

        .card-art {
            position: relative; overflow: hidden; aspect-ratio: 1; border-radius: 9px;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            box-shadow: 0 14px 30px rgba(0,0,0,.3);
        }

        .card-art img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .card-fallback { width: 100%; height: 100%; display: grid; place-items: center; font-size: 2.7rem; font-weight: 900; }

        .card-rank {
            position: absolute; top: 9px; left: 9px; z-index: 2; min-width: 31px; height: 31px;
            padding: 0 9px; border-radius: 50px; display: grid; place-items: center;
            background: rgba(0,0,0,.72); backdrop-filter: blur(8px); font-size: .78rem; font-weight: 900;
        }

        .card-lock {
            position: absolute; top: 9px; right: 9px; z-index: 2; width: 31px; height: 31px;
            border-radius: 50%; display: grid; place-items: center; background: rgba(0,0,0,.72);
            color: #fbbf24; backdrop-filter: blur(8px); font-size: .8rem;
        }

        .card-play {
            position: absolute; right: 10px; bottom: 10px; width: 45px; height: 45px; border: 0;
            border-radius: 50%; display: grid; place-items: center; color: #fff; cursor: pointer;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            box-shadow: 0 10px 25px rgba(168,85,247,.4); font-size: 1.25rem;
            opacity: 0; transform: translateY(9px) scale(.9); transition: opacity .2s, transform .24s;
        }

        .song-card:hover .card-play, .card-play:focus-visible { opacity: 1; transform: translateY(0) scale(1); }
        .card-title { margin-top: 13px; font-size: .94rem; font-weight: 750; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .card-artist { margin-top: 4px; color: var(--txt-3); font-size: .79rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .card-meta { display: flex; align-items: center; justify-content: space-between; gap: 7px; margin-top: 11px; }
        .card-genre { color: var(--txt-3); font-size: .72rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

        .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; }

        .chip {
            height: 32px; padding: 0 15px; border-radius: 50px; border: none; background: var(--panel-3);
            color: var(--txt); font-family: inherit; font-size: .83rem; font-weight: 600; cursor: pointer;
            transition: background .18s, color .18s, transform .18s;
        }

        .chip:hover { background: #2f2f2f; }
        .chip.on { background: var(--txt); color: #000; }
        .chip:active { transform: scale(.94); }

        /* ---------- TRACK LIST ---------- */
        .thead {
            display: grid; grid-template-columns: 38px minmax(0, 1fr) 150px 110px 74px; gap: 14px; padding: 0 12px 10px;
            font-size: .74rem; font-weight: 700; letter-spacing: 1.1px; text-transform: uppercase;
            color: var(--txt-3); border-bottom: 1px solid var(--line);
        }

        .trow {
            display: grid; grid-template-columns: 38px minmax(0, 1fr) 150px 110px 74px; gap: 14px; align-items: center;
            min-width: 0;
            padding: 9px 12px; border-radius: 7px; transition: background .18s;
            animation: fadeUp .5s cubic-bezier(.22,1,.36,1) both;
        }

        .trow:hover { background: var(--panel-2); }
        .trow.locked { opacity: .52; }

        .t-num { color: var(--txt-3); font-size: .92rem; text-align: center; position: relative; }
        .trow:hover .t-num .n { display: none; }
        .t-num .p { display: none; color: var(--txt); font-size: 1.05rem; cursor: pointer; }
        .trow:hover .t-num .p { display: block; }

        .t-main { display: flex; align-items: center; gap: 13px; min-width: 0; }

        .t-art-fb {
            width: 42px; height: 42px; border-radius: 5px; flex-shrink: 0; display: grid; place-items: center;
            overflow: hidden; font-size: 1rem; font-weight: 800; background: linear-gradient(135deg, var(--accent), var(--accent-2));
        }

        .t-art-fb img { width: 100%; height: 100%; object-fit: cover; }

        .t-title {
            font-size: .95rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
            display: flex; align-items: center; gap: 7px;
        }

        .t-title .bi-lock-fill { color: var(--txt-3); font-size: .8rem; }
        .t-sub { font-size: .8rem; color: var(--txt-3); margin-top: 2px; }

        .badge {
            display: inline-flex; align-items: center; gap: 5px; height: 24px; padding: 0 11px;
            border-radius: 50px; font-size: .74rem; font-weight: 800; letter-spacing: .3px;
        }

        .b-basic { background: rgba(255,255,255,.1); color: var(--txt-2); }
        .b-gold { background: rgba(245,158,11,.16); color: #fbbf24; }
        .b-premium { background: rgba(168,85,247,.18); color: #c084fc; }
        .b-elit { background: linear-gradient(120deg, var(--accent), var(--accent-2)); color: #fff; }

        .t-plays { font-size: .86rem; color: var(--txt-3); }
        .t-dur { font-size: .86rem; color: var(--txt-3); text-align: right; }

        .empty { text-align: center; padding: 50px 20px; color: var(--txt-3); }
        .empty i { font-size: 2.3rem; display: block; margin-bottom: 12px; }

        /* ---------- PLAYER ---------- */
        .player {
            grid-column: 1 / -1; grid-row: 2; min-width: 0; overflow: hidden;
            display: flex; align-items: center; gap: 16px; padding: 0 16px;
        }
        .np { display: flex; align-items: center; gap: 12px; width: 260px; min-width: 0; }

        .np-art {
            width: 54px; height: 54px; border-radius: 6px;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            display: grid; place-items: center; font-size: 1.3rem; flex-shrink: 0; transition: transform .4s;
        }

        .np-art.spin { animation: spin 6s linear infinite; }

        .np-name { font-size: .88rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .np-sub { font-size: .76rem; color: var(--txt-3); display: flex; align-items: center; gap: 8px; }

        .eq { display: none; align-items: flex-end; gap: 2px; width: 20px; height: 15px; }
        .eq.on { display: flex; }
        .eq span { flex: 1; background: var(--ok); border-radius: 1px; animation: eqBar .85s ease-in-out infinite; }
        .eq span:nth-child(2) { animation-delay: .18s; }
        .eq span:nth-child(3) { animation-delay: .36s; }
        .eq span:nth-child(4) { animation-delay: .54s; }

        .pl-center { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 8px; }
        .pl-btns { display: flex; align-items: center; gap: 20px; }
        .pl-btns button { border: none; background: transparent; color: var(--txt-2); font-size: 1.05rem; cursor: pointer; }
        .pl-btns button:hover { color: var(--txt); }

        .pl-play {
            width: 36px; height: 36px; border-radius: 50%; background: var(--txt) !important; color: #000 !important;
            display: grid; place-items: center; font-size: 1.1rem !important; transition: transform .25s cubic-bezier(.34,1.56,.64,1);
        }

        .pl-play:hover { transform: scale(1.12); }

        .pl-bar { display: flex; align-items: center; gap: 10px; width: 100%; max-width: 520px; font-size: .7rem; color: var(--txt-3); }
        .track { flex: 1; height: 4px; border-radius: 4px; background: #4d4d4d; overflow: hidden; cursor: pointer; }
        .track-fill { height: 100%; width: 0; background: var(--txt); transition: width .2s linear; }

        .pl-right { display: flex; align-items: center; gap: 12px; width: 200px; justify-content: flex-end; color: var(--txt-2); font-size: 1rem; }
        .vol { width: 92px; height: 4px; border-radius: 4px; background: #4d4d4d; }
        .vol-fill { height: 100%; width: 68%; border-radius: 4px; background: var(--txt); }

        /* ---------- MODAL ---------- */
        .backdrop {
            position: fixed; inset: 0; z-index: 90; background: rgba(0,0,0,.72); backdrop-filter: blur(6px);
            display: none; align-items: center; justify-content: center; padding: 24px;
        }

        .backdrop.on { display: flex; animation: fadeIn .2s ease; }

        .modal-card {
            width: 100%; max-width: 412px; padding: 30px 28px 26px; border-radius: 18px; text-align: center;
            background: #16161f; border: 1px solid var(--line); animation: pop .38s cubic-bezier(.22,1,.36,1) both;
        }

        .modal-ico {
            width: 62px; height: 62px; margin: 0 auto 18px; border-radius: 50%; display: grid; place-items: center;
            font-size: 1.7rem; background: linear-gradient(135deg, var(--accent), var(--accent-2));
        }

        .modal-card h3 { font-size: 1.3rem; font-weight: 800; letter-spacing: -.5px; margin-bottom: 10px; }
        .modal-card p { font-size: .94rem; color: var(--txt-2); line-height: 1.6; }

        .modal-pkg {
            display: inline-flex; align-items: center; gap: 7px; margin-top: 16px; padding: 7px 14px;
            border-radius: 50px; background: rgba(255,255,255,.06); border: 1px solid var(--line);
            font-size: .82rem; color: var(--txt-2);
        }

        .modal-acts { display: flex; gap: 10px; margin-top: 24px; }
        .modal-acts button {
            flex: 1; height: 46px; border-radius: 12px; border: none; font-family: inherit;
            font-size: .93rem; font-weight: 800; cursor: pointer; transition: transform .2s, filter .2s;
        }

        .m-ghost { background: transparent; border: 1px solid var(--line) !important; color: var(--txt); }
        .m-ghost:hover { border-color: rgba(255,255,255,.4) !important; }
        .m-cta { background: linear-gradient(120deg, var(--accent), var(--accent-2)); color: #fff; }
        .m-cta:hover { transform: translateY(-2px); filter: brightness(1.12); }

        ::-webkit-scrollbar { width: 11px; }
        ::-webkit-scrollbar-thumb { background: #4a4a4a; border-radius: 6px; border: 3px solid transparent; background-clip: content-box; }

        @@keyframes fadeUp { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: translateY(0); } }
        @@keyframes floatOrb { 0%, 100% { transform: translate(0,0) scale(1); } 50% { transform: translate(38px,-26px) scale(1.14); } }
        @@keyframes spin { to { transform: rotate(360deg); } }
        @@keyframes eqBar { 0%, 100% { height: 22%; } 50% { height: 100%; } }
        @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @@keyframes pop { from { opacity: 0; transform: scale(.92); } to { opacity: 1; transform: scale(1); } }

        @@media (max-width: 1000px) {
            .shell { grid-template-columns: minmax(0, 1fr); }
            .rail { display: none; }
            .np, .pl-right { width: auto; }
            .pl-right { display: none; }
            .featured-grid { grid-template-columns: repeat(auto-fit, minmax(145px, 1fr)); }
        }

        @@media (max-width: 680px) {
            .topbar, .hero, .sec { padding-left: 16px; padding-right: 16px; }
            .topbar { gap: 9px; }
            .pkg-pill { padding: 0 10px; }
            .hero-title { font-size: 2.7rem; }
            .featured-grid {
                display: flex; width: calc(100% + 16px); max-width: calc(100% + 16px);
                overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; padding: 0 16px 8px 0;
            }
            .song-card { flex: 0 0 164px; scroll-snap-align: start; }
            .card-play { opacity: 1; transform: none; width: 40px; height: 40px; }
            .thead { display: none; }
            .trow { grid-template-columns: 30px minmax(0, 1fr) auto; gap: 9px; padding: 9px 4px; }
            .trow > div:nth-child(4), .trow > div:nth-child(5) { display: none; }
            .badge { padding: 0 8px; }
            .player { padding: 0 10px; }
            .np { width: 150px; }
            .np-art { width: 44px; height: 44px; }
            .pl-btns button:not(.pl-play) { display: none; }
            .pl-bar { display: none; }
        }
    </style>
</head>
<body>
    <div class="shell">

        <aside class="rail">
            <div class="rail-box">
                <div class="brand">
                    <div class="brand-dot"><i class="bi bi-broadcast"></i></div>
                    Echoa
                </div>
                <a class="nav-item" href="/Home/Index"><i class="bi bi-house-door"></i>Ana sayfa</a>
                <a class="nav-item" href="/Artist/ArtistListV2"><i class="bi bi-person-badge"></i>Sanatçılar</a>
                <a class="nav-item" href="/Genre/GenreList"><i class="bi bi-collection"></i>Türler</a>
                <a class="nav-item on" href="/Song/Charts"><i class="bi bi-music-note-list"></i>Top Charts</a>
            </div>

            <div class="rail-scroll">
                <div class="rail-head"><span><i class="bi bi-fire"></i>&nbsp; Zirvedekiler</span></div>
                @for (int i = 0; i < Math.Min(6, ranked.Count); i++)
                {
                    var s = ranked[i];
                    <div class="lib-row">
                        <div class="lib-num">@(i + 1)</div>
                        <div class="lib-thumb">@s.SongName.Substring(0, 1)</div>
                        <div style="min-width:0">
                            <div class="lib-name">@s.SongName</div>
                            <div class="lib-sub">@s.ArtistName</div>
                        </div>
                    </div>
                }
            </div>
        </aside>

        <main class="main" id="main">

            <div class="topbar" id="topbar">
                <div class="search">
                    <i class="bi bi-search"></i>
                    <input id="q" type="text" placeholder="Şarkı veya sanatçı ara" autocomplete="off" />
                </div>
                <div class="spacer"></div>
                <div class="pkg-pill"><i class="bi bi-gem"></i>@userPkg</div>
                <div class="avatar-pill"><i class="bi bi-person-fill"></i></div>
            </div>

            <section class="hero">
                <div class="orb orb-a"></div>
                <div class="orb orb-b"></div>
                <div class="hero-kicker">Haftalık Liste</div>
                <h1 class="hero-title">Top Charts</h1>
                <div class="hero-meta">
                    <span>@Model.Count şarkı</span>
                    <span class="dot-sep"></span>
                    <span>@Model.Sum(s => s.ListenCount).ToString("N0") dinlenme</span>
                    <span class="dot-sep"></span>
                    <span>@genres.Count tür</span>
                </div>
            </section>

            <section class="sec">
                <div class="sec-head">
                    <h2 class="sec-title">Popüler şarkılar</h2>
                    <button class="sec-link" id="showAll" type="button">Tüm şarkıları gör <i class="bi bi-arrow-down"></i></button>
                </div>

                @if (ranked.Count > 0)
                {
                    <div class="featured-grid">
                        @for (int i = 0; i < Math.Min(6, ranked.Count); i++)
                        {
                            var featured = ranked[i];
                            var featuredLocked = userLevel < featured.PackageLevel;
                            <article class="song-card @(featuredLocked ? "locked" : "")" style="animation-delay:@(i * 55)ms">
                                <div class="card-art">
                                    @if (!string.IsNullOrWhiteSpace(featured.CoverImageUrl))
                                    {
                                        <img src="@featured.CoverImageUrl" alt="@featured.SongName kapağı" />
                                    }
                                    else
                                    {
                                        <div class="card-fallback">@featured.SongName.Substring(0, 1)</div>
                                    }
                                    <span class="card-rank">#@(i + 1)</span>
                                    @if (featuredLocked)
                                    {
                                        <span class="card-lock" title="@featured.PackageName paketi gerekiyor"><i class="bi bi-lock-fill"></i></span>
                                    }
                                    <button class="card-play featured-listen" type="button" aria-label="@featured.SongName şarkısını çal"
                                            data-id="@featured.SongId" data-name="@featured.SongName"
                                            data-artist="@featured.ArtistName" data-pkg="@featured.PackageName">
                                        <i class="bi @(featuredLocked ? "bi-lock-fill" : "bi-play-fill")"></i>
                                    </button>
                                </div>
                                <h3 class="card-title">@featured.SongName</h3>
                                <div class="card-artist">@featured.ArtistName</div>
                                <div class="card-meta">
                                    <span class="card-genre">@featured.GenreName</span>
                                    <span class="badge b-@featured.PackageName.ToLower()">@featured.PackageName</span>
                                </div>
                            </article>
                        }
                    </div>
                }

                <div class="sec-head" id="songList">
                    <h2 class="sec-title">Tüm şarkılar</h2>
                    <span class="card-genre">@ranked.Count parça</span>
                </div>

                <div class="chips" id="chips">
                    <button class="chip on" data-g="all">Tümü</button>
                    @foreach (var g in genres)
                    {
                        <button class="chip" data-g="@g.ToLower()">@g</button>
                    }
                </div>

                @if (ranked.Count == 0)
                {
                    <div class="empty"><i class="bi bi-music-note-beamed"></i>Henüz şarkı yok.</div>
                }
                else
                {
                    <div class="thead">
                        <div>#</div>
                        <div>Başlık</div>
                        <div>Paket</div>
                        <div class="t-plays">Dinlenme</div>
                        <div style="text-align:right"><i class="bi bi-clock"></i></div>
                    </div>
                    <div id="grid">
                        @for (int i = 0; i < ranked.Count; i++)
                        {
                            var s = ranked[i];
                            var locked = userLevel < s.PackageLevel;
                            <div class="trow @(locked ? "locked" : "")"
                                 style="animation-delay:@(i * 30)ms"
                                 data-name="@s.SongName.ToLower()" data-artist="@s.ArtistName.ToLower()" data-g="@(s.GenreName == null ? "" : s.GenreName.ToLower())">
                                <div class="t-num">
                                    <span class="n">@(i + 1)</span>
                                    <i class="bi bi-play-fill p listen" data-id="@s.SongId" data-name="@s.SongName" data-artist="@s.ArtistName" data-pkg="@s.PackageName"></i>
                                </div>
                                <div class="t-main">
                                    <div class="t-art-fb">
                                        @if (!string.IsNullOrWhiteSpace(s.CoverImageUrl))
                                        {
                                            <img src="@s.CoverImageUrl" alt="" />
                                        }
                                        else
                                        {
                                            @s.SongName.Substring(0, 1)
                                        }
                                    </div>
                                    <div style="min-width:0">
                                        <div class="t-title">
                                            <span>@s.SongName</span>
                                            @if (locked)
                                            {
                                                <i class="bi bi-lock-fill" title="@s.PackageName paketi gerekiyor"></i>
                                            }
                                        </div>
                                        <div class="t-sub">@s.ArtistName</div>
                                    </div>
                                </div>
                                <div><span class="badge b-@s.PackageName.ToLower()">@s.PackageName</span></div>
                                <div class="t-plays">@s.ListenCount.ToString("N0")</div>
                                <div class="t-dur">@s.Duration.ToString("mm\\:ss")</div>
                            </div>
                        }
                        <div class="empty" id="empty" style="display:none">
                            <i class="bi bi-search"></i>
                            Aramanla eşleşen şarkı yok.
                        </div>
                    </div>
                }
            </section>

        </main>

        <div class="player">
            <div class="np">
                <div class="np-art" id="npArt"><i class="bi bi-music-note-beamed"></i></div>
                <div style="min-width:0">
                    <div class="np-name" id="npName">Bir şarkı seç</div>
                    <div class="np-sub">
                        <span id="npSub">Çalan bir şey yok</span>
                        <span class="eq" id="eq"><span></span><span></span><span></span><span></span></span>
                    </div>
                </div>
            </div>
            <div class="pl-center">
                <div class="pl-btns">
                    <button aria-label="Karıştır"><i class="bi bi-shuffle"></i></button>
                    <button aria-label="Önceki"><i class="bi bi-skip-start-fill"></i></button>
                    <button class="pl-play" id="plPlay" aria-label="Çal"><i class="bi bi-play-fill" id="plIcon"></i></button>
                    <button aria-label="Sonraki"><i class="bi bi-skip-end-fill"></i></button>
                    <button aria-label="Tekrarla"><i class="bi bi-repeat"></i></button>
                </div>
                <div class="pl-bar">
                    <span id="tCur">0:00</span>
                    <div class="track" id="track"><div class="track-fill" id="trackFill"></div></div>
                    <span id="tEnd">3:20</span>
                </div>
            </div>
            <div class="pl-right">
                <i class="bi bi-volume-up"></i>
                <div class="vol"><div class="vol-fill"></div></div>
            </div>
        </div>

    </div>

    <div class="backdrop" id="lockModal">
        <div class="modal-card">
            <div class="modal-ico"><i class="bi bi-lock-fill"></i></div>
            <h3>Bu şarkı paketinde yok</h3>
            <p id="lockMsg">Mevcut paketiniz bu şarkıyı desteklememektedir. Lütfen paketinizi yükseltin.</p>
            <div class="modal-pkg">
                <i class="bi bi-gem"></i>
                Paketin: <strong>&nbsp;@userPkg</strong>
            </div>
            <div class="modal-acts">
                <button class="m-ghost" id="lockClose" type="button">Kapat</button>
                <button class="m-cta" type="button">Paketi yükselt</button>
            </div>
        </div>
    </div>

    <audio id="audio"></audio>

    <script>
        var main = document.getElementById('main');
        var topbar = document.getElementById('topbar');
        main.addEventListener('scroll', function () {
            topbar.classList.toggle('stuck', main.scrollTop > 8);
        });

        var rows = Array.prototype.slice.call(document.querySelectorAll('#grid .trow'));
        var empty = document.getElementById('empty');
        var q = document.getElementById('q');
        var genre = 'all';

        function apply() {
            var text = q.value.trim().toLowerCase();
            var shown = 0;
            rows.forEach(function (r) {
                var okText = text === '' || r.dataset.name.indexOf(text) > -1 || r.dataset.artist.indexOf(text) > -1;
                var okGenre = genre === 'all' || r.dataset.g === genre;
                var show = okText && okGenre;
                r.style.display = show ? '' : 'none';
                if (show) { shown++; }
            });
            if (empty) { empty.style.display = shown === 0 ? 'block' : 'none'; }
        }

        q.addEventListener('input', apply);

        document.getElementById('showAll').addEventListener('click', function () {
            document.getElementById('songList').scrollIntoView({ behavior: 'smooth', block: 'start' });
        });

        document.getElementById('chips').addEventListener('click', function (e) {
            var btn = e.target.closest('.chip');
            if (!btn) { return; }
            document.querySelectorAll('#chips .chip').forEach(function (b) { b.classList.remove('on'); });
            btn.classList.add('on');
            genre = btn.dataset.g;
            apply();
        });

        var modal = document.getElementById('lockModal');
        var lockMsg = document.getElementById('lockMsg');
        document.getElementById('lockClose').addEventListener('click', function () { modal.classList.remove('on'); });
        modal.addEventListener('click', function (e) { if (e.target === modal) { modal.classList.remove('on'); } });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { modal.classList.remove('on'); } });

        var audio = document.getElementById('audio');
        var eq = document.getElementById('eq');
        var npArt = document.getElementById('npArt');
        var npName = document.getElementById('npName');
        var npSub = document.getElementById('npSub');
        var plPlay = document.getElementById('plPlay');
        var plIcon = document.getElementById('plIcon');
        var trackFill = document.getElementById('trackFill');
        var tCur = document.getElementById('tCur');

        var playing = false, seconds = 0, total = 200, timer = null;

        function fmt(s) {
            var m = Math.floor(s / 60), r = Math.floor(s % 60);
            return m + ':' + (r < 10 ? '0' + r : r);
        }

        function render() {
            trackFill.style.width = Math.round((seconds / total) * 100) + '%';
            tCur.textContent = fmt(seconds);
        }

        function setPlaying(on) {
            playing = on;
            eq.classList.toggle('on', on);
            npArt.classList.toggle('spin', on);
            plIcon.className = on ? 'bi bi-pause-fill' : 'bi bi-play-fill';
            clearInterval(timer);
            if (on) {
                timer = setInterval(function () {
                    seconds++;
                    if (seconds >= total) { seconds = 0; }
                    render();
                }, 1000);
            }
        }

        plPlay.addEventListener('click', function () { setPlaying(!playing); });

        document.getElementById('track').addEventListener('click', function (e) {
            var r = this.getBoundingClientRect();
            seconds = Math.round(((e.clientX - r.left) / r.width) * total);
            render();
        });

        async function requestListen(id, name, artist, pkg) {
            var res = await fetch('/Song/Listen/' + id, { method: 'POST' });

            if (res.status === 403) {
                lockMsg.textContent = name + ' şarkısı ' + pkg + ' paketine ait. Mevcut paketiniz bu şarkıyı desteklememektedir. Lütfen paketinizi yükseltin.';
                modal.classList.add('on');
                return;
            }

            if (res.status === 401) {
                window.location.href = '/Login/SignIn';
                return;
            }

            if (!res.ok) { return; }

            var data = await res.json();
            npName.textContent = data.songName || name;
            npSub.textContent = data.artistName || artist;
            seconds = 0;
            render();
            setPlaying(true);

            if (data.audioUrl) {
                audio.src = data.audioUrl;
                audio.play().catch(function () { });
            }
        }

        document.querySelectorAll('.listen, .featured-listen').forEach(function (el) {
            el.addEventListener('click', function () {
                requestListen(this.dataset.id, this.dataset.name, this.dataset.artist, this.dataset.pkg);
            });
        });

        render();
    </script>
</body>
</html>
