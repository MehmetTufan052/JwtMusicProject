@{
    var activePage = ViewData["AdminPage"]?.ToString() ?? "Dashboard";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Echoa</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-shell">
        <aside class="admin-sidebar" id="adminSidebar">
            <a class="admin-brand" asp-controller="Home" asp-action="Index"><span class="admin-brand-mark"><i class="bi bi-broadcast"></i></span>Echoa</a>
            <div class="admin-nav-label">Yönetim</div>
            <nav class="admin-nav" aria-label="Yönetim menüsü">
                <a class="admin-nav-item @(activePage == "Dashboard" ? "active" : "")" asp-controller="Admin" asp-action="Index"><i class="bi bi-grid-1x2-fill"></i>Genel Bakış</a>
                <a class="admin-nav-item @(activePage == "Songs" ? "active" : "")" asp-controller="Admin" asp-action="Songs"><i class="bi bi-music-note-beamed"></i>Şarkılar</a>
                <a class="admin-nav-item @(activePage == "Artists" ? "active" : "")" asp-controller="Admin" asp-action="Artists"><i class="bi bi-mic-fill"></i>Sanatçılar</a>
                <a class="admin-nav-item @(activePage == "Genres" ? "active" : "")" asp-controller="Admin" asp-action="Genres"><i class="bi bi-vinyl-fill"></i>Türler</a>
                <a class="admin-nav-item @(activePage == "Users" ? "active" : "")" asp-controller="Admin" asp-action="Users"><i class="bi bi-people-fill"></i>Kullanıcılar</a>
            </nav>
            <div class="admin-sidebar-foot">
                <div class="admin-profile"><span class="admin-avatar">A</span><span><strong>Yönetici</strong><small>Echoa Admin</small></span></div>
                <a class="admin-nav-item" asp-controller="Home" asp-action="Index"><i class="bi bi-arrow-left"></i>Siteye dön</a>
                <a class="admin-nav-item admin-logout" asp-controller="Login" asp-action="Logout"><i class="bi bi-box-arrow-right"></i>Çıkış yap</a>
            </div>
        </aside>
        <main class="admin-main">
            <header class="admin-topbar">
                <button class="admin-menu-toggle" id="adminMenuToggle" type="button" aria-label="Menüyü aç" aria-expanded="false"><i class="bi bi-list"></i></button>
                <span class="admin-page-name">@ViewData["Title"]</span><span class="admin-topbar-spacer"></span>
                <span class="admin-status"><span class="admin-status-dot"></span><span>Sistem aktif</span></span>
                <a class="admin-site-link" asp-controller="Home" asp-action="Index" aria-label="Siteyi görüntüle" title="Siteyi görüntüle"><i class="bi bi-arrow-up-right"></i></a>
            </header>
            <div class="admin-content">@RenderBody()</div>
        </main>
    </div>
    <script>
        const adminMenuToggle = document.getElementById('adminMenuToggle');
        const adminSidebar = document.getElementById('adminSidebar');
        adminMenuToggle?.addEventListener('click', () => {
            const isOpen = adminSidebar.classList.toggle('open');
            adminMenuToggle.setAttribute('aria-expanded', isOpen.toString());
            adminMenuToggle.querySelector('i').className = isOpen ? 'bi bi-x-lg' : 'bi bi-list';
        });
        document.addEventListener('click', event => {
            if (window.innerWidth <= 780 && adminSidebar.classList.contains('open') && !adminSidebar.contains(event.target) && !adminMenuToggle.contains(event.target)) {
                adminSidebar.classList.remove('open');
                adminMenuToggle.setAttribute('aria-expanded', 'false');
                adminMenuToggle.querySelector('i').className = 'bi bi-list';
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
